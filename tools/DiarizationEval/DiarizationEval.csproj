<Project Sdk="Microsoft.NET.Sdk">

  <!-- Console around SpeechLib.Diarization: DER on RTTM-labelled wavs, parity against DiarBench dumps, RTF and
       peak memory for any preset. The DER scorer source is shared with the test project. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\libraries\SpeechLib\src\SpeechLib.Diarization\SpeechLib.Diarization.csproj" />
    <Compile Include="..\..\libraries\SpeechLib\tests\SpeechLib.Diarization.Tests\Support\DerScorer.cs" Link="DerScorer.cs" />
  </ItemGroup>

</Project>
