<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Windows smoke test for the VoiceType.Uno recording player (no UI): encodes WAVs to
    Ogg Opus with SpeechLib.AudioStorage, plays the file through the real WASAPI output,
    seeks, changes speed, pauses, and logs PositionChanged / Ended against the wall clock.
    The player sources are linked from the Uno app (its Uno TFMs cannot be referenced).
      dotnet run -c Release (project tools/PlaybackProbe) followed by one or more 16 kHz WAV paths
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\apps\VoiceType.Uno\src\VoiceType.Uno\Services\Playback\IAudioPlayer.cs" Link="Linked\IAudioPlayer.cs" />
    <Compile Include="..\..\apps\VoiceType.Uno\src\VoiceType.Uno\Services\Playback\IPcmOutput.cs" Link="Linked\IPcmOutput.cs" />
    <Compile Include="..\..\apps\VoiceType.Uno\src\VoiceType.Uno\Services\Playback\PcmAudioPlayer.cs" Link="Linked\PcmAudioPlayer.cs" />
    <Compile Include="..\..\apps\VoiceType.Uno\src\VoiceType.Uno\Services\Playback\WasapiPcmOutput.cs" Link="Linked\WasapiPcmOutput.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\apps\VoiceType.Uno\src\VoiceType.Uno.Core\VoiceType.Uno.Core.csproj" />
    <ProjectReference Include="..\..\libraries\SpeechLib\src\SpeechLib.AudioStorage\SpeechLib.AudioStorage.csproj" />
    <ProjectReference Include="..\..\libraries\SpeechLib\src\SpeechLib.Audio.NAudio3\SpeechLib.Audio.NAudio3.csproj" />
  </ItemGroup>

</Project>
