<Window x:Class="IntentTestHarness.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Intent Test Harness" Width="520" Height="420"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"
                   Text="Voice Intent Mode test harness — dictate into fields, then say «набери в тест харнесс»"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="Поле 1 (Editor)"/>
            <TextBox x:Name="Field1" AutomationProperties.AutomationId="Field1"
                     AutomationProperties.Name="Поле 1" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <TextBlock Text="Поле 2 (Notes)"/>
            <TextBox x:Name="Field2" AutomationProperties.AutomationId="Field2"
                     AutomationProperties.Name="Поле 2" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
        </StackPanel>

        <StackPanel Grid.Row="3">
            <TextBlock Text="Поле 3 (Terminal)"/>
            <TextBox x:Name="Field3" AutomationProperties.AutomationId="Field3"
                     AutomationProperties.Name="Поле 3" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
        </StackPanel>
    </Grid>
</Window>
