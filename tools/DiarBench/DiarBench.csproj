<Project Sdk="Microsoft.NET.Sdk">

  <!-- Feasibility spike: C# ONNX Runtime parity + benchmark for Nemotron-3-Diarization.
       Standalone on purpose (not in NemotronSpeech.slnx). Same ORT version as SpeechLib.Providers. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
  </ItemGroup>

</Project>
