<Window
    x:Class="VoiceType.WinUI.Views.AudioMixerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:VoiceType.WinUI.ViewModels"
    x:DataType="vm:AudioMixerViewModel"
    Title="Audio Mixer">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop/>
    </Window.SystemBackdrop>

    <Grid Background="{StaticResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40" Background="{StaticResource BgSecondaryBrush}">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0,0,0">
                <FontIcon Glyph="&#xE767;" FontSize="16" Foreground="{StaticResource AccentBrush}"/>
                <TextBlock Text="Audio Mixer" Foreground="{StaticResource FgBrush}"
                           Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="14,10">
            <StackPanel Spacing="16">

                <!-- Master Level -->
                <Border Background="{StaticResource BgSecondaryBrush}" CornerRadius="4" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Master Level" Foreground="{StaticResource FgBrush}"
                                   FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE720;" FontSize="14"
                                      Foreground="{StaticResource AccentBrush}"
                                      VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ProgressBar Grid.Column="1" Height="8"
                                         Minimum="0" Maximum="1"
                                         Value="{x:Bind ViewModel.AudioLevel, Mode=OneWay}"
                                         Foreground="{StaticResource AccentBrush}"
                                         Background="{StaticResource BgTertiaryBrush}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Mic Volume -->
                <Border Background="{StaticResource BgSecondaryBrush}" CornerRadius="4" Padding="12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Microphone" Foreground="{StaticResource FgBrush}"
                                       FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.MicVolumePercent, Mode=OneWay}"
                                       Foreground="{StaticResource AccentBrush}" FontSize="12"
                                       FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Grid>
                        <Slider Minimum="0" Maximum="1" StepFrequency="0.01"
                                Value="{x:Bind ViewModel.MicVolume, Mode=TwoWay}"
                                Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Loopback Volume -->
                <Border Background="{StaticResource BgSecondaryBrush}" CornerRadius="4" Padding="12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="System Audio (Loopback)" Foreground="{StaticResource FgBrush}"
                                       FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.LoopbackVolumePercent, Mode=OneWay}"
                                       Foreground="{StaticResource AccentBrush}" FontSize="12"
                                       FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Grid>
                        <Slider Minimum="0" Maximum="1" StepFrequency="0.01"
                                Value="{x:Bind ViewModel.LoopbackVolume, Mode=TwoWay}"
                                Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Info -->
                <Border Background="{StaticResource BgTertiaryBrush}" CornerRadius="4" Padding="12">
                    <TextBlock Text="Volume changes apply in real-time during recording. Settings are saved automatically."
                               Foreground="{StaticResource FgSecondaryBrush}" FontSize="11"
                               TextWrapping="Wrap"/>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Bottom buttons -->
        <Border Grid.Row="2" Background="{StaticResource BgSecondaryBrush}" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Changes apply immediately"
                           Foreground="{StaticResource FgSecondaryBrush}" FontSize="11"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Close"
                        Background="{StaticResource BgTertiaryBrush}" Foreground="{StaticResource FgBrush}"
                        BorderThickness="0" Padding="24,8" FontSize="12"
                        Click="CloseButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
