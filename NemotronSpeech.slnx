  <!--
    VoiceType.Uno lives under apps/VoiceType.Uno/src with its own VoiceType.Uno.sln
    and global.json (Uno.Sdk resolution requires the local global.json).
    Build it separately: dotnet build apps/VoiceType.Uno/src/VoiceType.Uno.sln -p:GpuArch=CPU
  -->
  <Folder Name="/apps/VoiceType.Uno/" />
  <Folder Name="/build/">
    <Project Path="build/AudioConvertProbe/AudioConvertProbe.csproj" />
  </Folder>
