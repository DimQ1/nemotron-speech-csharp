    <Project Path="libraries/SpeechLib/src/SpeechLib.Nemotron/SpeechLib.Nemotron.csproj" />
    <Project Path="libraries/SpeechLib/src/SpeechLib.ParakeetTdt/SpeechLib.ParakeetTdt.csproj" />
    <Project Path="libraries/SpeechLib/src/SpeechLib.ModelDownload/SpeechLib.ModelDownload.csproj" />
