<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

    <!-- Single source of truth: the CPU ONNX Runtime GenAI packages live on
      nuget.org. The former ORT-Nightly feed existed only for the removed
      CUDA / DirectML build variants. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
