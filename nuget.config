<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="ORT-Nightly" value="https://aiinfra.pkgs.visualstudio.com/PublicPackages/_packaging/ORT-Nightly/nuget/v3/index.json" />
  </packageSources>

    <!-- Keep the stable CPU GenAI package on nuget.org. The CUDA and DirectML
      variants use the ORT-Nightly feed for their native assets. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
      <package pattern="Microsoft.ML.OnnxRuntimeGenAI" />
    </packageSource>
    <packageSource key="ORT-Nightly">
      <package pattern="Microsoft.ML.OnnxRuntimeGenAI.Cuda*" />
      <package pattern="Microsoft.ML.OnnxRuntimeGenAI.DirectML*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
