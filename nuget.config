<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!--
      LiteRtLmSharp 1.4.0 (native LiteRT-LM v0.18.0) is published from the fork
      github.com/DimQ1/LiteRtLmSharp: upstream's own 1.3.0 on nuget.org is a different build without the
      engine-usage improvements this repository uses (proposed upstream as OrihuelaConde/LiteRtLmSharp#15).
      The fork's .nupkg files live in this local folder feed, populated once per clone by
      `pwsh tools/scripts/fetch-litertlmsharp-feed.ps1` from the fork's public v1.4.0 release — no
      token, no GitHub CLI. See nuget-feed/litertlmsharp/README.md.
    -->
    <add key="litertlmsharp-local" value="nuget-feed\litertlmsharp" />
    <!--
      The same packages are on the fork's GitHub Packages feed as well. GitHub requires an authenticated
      read for it even though both repositories are public, so it is left out of the default sources:
      uncomment it (and give the token the read:packages scope) to consume the published feed instead of
      the release assets. %GITHUB_PACKAGES_TOKEN% is expanded by NuGet, so no credential is committed.

      <add key="github-dimq1" value="https://nuget.pkg.github.com/DimQ1/index.json" />
    -->
  </packageSources>

  <!--
    Only used when the github-dimq1 source above is enabled.
  -->
  <packageSourceCredentials>
    <github-dimq1>
      <add key="Username" value="DimQ1" />
      <add key="ClearTextPassword" value="%GITHUB_PACKAGES_TOKEN%" />
    </github-dimq1>
  </packageSourceCredentials>

  <!--
    Single source of truth: the CPU ONNX Runtime GenAI packages (and everything else) come from
    nuget.org; the fork's LiteRtLmSharp packages may come from the local folder feed, the fork's GitHub
    Packages feed, or nuget.org (the 1.2.0 engine, if the project is pinned back to it). Mapping keeps a
    same-id package from being pulled from an unexpected feed.
  -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="litertlmsharp-local">
      <package pattern="LiteRtLmSharp" />
      <package pattern="LiteRtLmSharp.*" />
    </packageSource>
    <packageSource key="github-dimq1">
      <package pattern="LiteRtLmSharp" />
      <package pattern="LiteRtLmSharp.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
