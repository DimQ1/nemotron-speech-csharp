<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Design tokens from the LVA prototype (TZ §14.7) — dark theme default -->
    <Color x:Key="BgColor">#0F1115</Color>
    <Color x:Key="PanelColor">#171A21</Color>
    <Color x:Key="Panel2Color">#1E222C</Color>
    <Color x:Key="AccentColor">#7C6CFF</Color>
    <Color x:Key="AccentSoftColor">#2E7C6CFF</Color>
    <Color x:Key="SuccessColor">#3ECF8E</Color>
    <Color x:Key="ErrorColor">#FF6B6B</Color>
    <Color x:Key="WorkingColor">#FFB454</Color>
    <Color x:Key="TextColor">#E8EAF0</Color>
    <Color x:Key="Text2Color">#9AA3B2</Color>

    <!-- Light theme alternatives -->
    <Color x:Key="LightBgColor">#F4F5F8</Color>
    <Color x:Key="LightPanelColor">#FFFFFF</Color>
    <Color x:Key="LightPanel2Color">#EEF0F5</Color>
    <Color x:Key="LightAccentColor">#6A5AE0</Color>
    <Color x:Key="LightTextColor">#1B1E26</Color>
    <Color x:Key="LightText2Color">#5B6472</Color>

    <x:Double x:Key="RadiusCard">16</x:Double>
    <x:Double x:Key="RadiusBubble">18</x:Double>
    <x:Double x:Key="FontBase">14</x:Double>
    <x:Double x:Key="FontH2">17</x:Double>
    <x:Double x:Key="FontH1">20</x:Double>

</ResourceDictionary>
