<Window
    x:Class="VoiceType.WinUI.Views.ModelDownloaderWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:VoiceType.WinUI.ViewModels"
    Title="Download manager">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop/>
    </Window.SystemBackdrop>

    <Grid x:Name="Root" Background="{StaticResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40" Background="{StaticResource BgSecondaryBrush}">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0,0,0">
                <FontIcon Glyph="&#xE896;" FontSize="16" Foreground="{StaticResource AccentBrush}"/>
                <TextBlock Text="Download manager" Foreground="{StaticResource FgBrush}"
                           Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Completion notices, one per finished model -->
        <ItemsControl Grid.Row="1" Margin="12,8,12,0" ItemsSource="{x:Bind ViewModel.Notices, Mode=OneWay}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DownloadNoticeViewModel">
                    <InfoBar IsOpen="True" IsClosable="True" Margin="0,0,0,4"
                             Title="{x:Bind Title}" Message="{x:Bind Message}" Severity="{x:Bind Severity}"
                             CloseButtonClick="Notice_CloseButtonClick"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Grid.Row="2" Margin="12,8,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>

            <!-- Catalog header: filter + folder -->
            <Grid Grid.Row="0" ColumnSpacing="8" RowSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ComboBox Grid.Row="0" Grid.Column="0" HorizontalAlignment="Stretch"
                          ItemsSource="{x:Bind ViewModel.UseCaseOptions, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedUseCase, Mode=TwoWay}"
                          DisplayMemberPath="DisplayName"
                          Style="{StaticResource DarkComboBox}"/>
                <Button Grid.Row="0" Grid.Column="1" Content="Translation model"
                        Background="{StaticResource BgTertiaryBrush}" Foreground="{StaticResource FgBrush}"
                        BorderThickness="0" Padding="12,5" FontSize="12"
                        ToolTipService.ToolTip="Download the Gemma 4 E2B model used for live translation (~2.6 GB)"
                        Command="{x:Bind ViewModel.DownloadTranslationModelCommand}"/>
                <TextBox Grid.Row="1" Grid.Column="0" Text="{x:Bind ViewModel.ModelsRootPath, Mode=TwoWay}"
                         Style="{StaticResource DarkTextBox}" FontSize="11"
                         ToolTipService.ToolTip="Folder the recognition models are downloaded into"/>
                <Button Grid.Row="1" Grid.Column="1" Content="Browse…"
                        Background="{StaticResource BgTertiaryBrush}" Foreground="{StaticResource FgBrush}"
                        BorderThickness="0" Padding="12,5" FontSize="12"
                        Command="{x:Bind ViewModel.BrowseRootCommand}"/>
            </Grid>

            <!-- Model cards: each has its own Download button, so several download at once -->
            <ListView Grid.Row="1" Margin="0,8,0,4" SelectionMode="None" Background="Transparent"
                      ItemsSource="{x:Bind ViewModel.FilteredModels, Mode=OneWay}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,8"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ModelCardViewModel">
                        <Border Background="{StaticResource BgSecondaryBrush}" CornerRadius="6" Padding="12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind CommercialName}" FontWeight="SemiBold" FontSize="14"
                                                   Foreground="{StaticResource FgBrush}" VerticalAlignment="Center"/>
                                        <Border Background="{StaticResource BgTertiaryBrush}" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="{x:Bind Variant}" FontSize="11" Foreground="{StaticResource FgSecondaryBrush}"/>
                                        </Border>
                                        <Border Background="{StaticResource AccentBrush}" CornerRadius="4" Padding="6,2"
                                                Visibility="{x:Bind IsRecommended}">
                                            <TextBlock Text="Recommended" FontSize="10" Foreground="White"/>
                                        </Border>
                                        <Border Background="{StaticResource GreenBrush}" CornerRadius="4" Padding="6,2"
                                                Visibility="{x:Bind InstalledVisibility, Mode=OneWay}">
                                            <TextBlock Text="Installed" FontSize="10" Foreground="Black"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind Tagline}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                    <TextBlock Text="{x:Bind Description}" FontSize="11" Foreground="{StaticResource FgSecondaryBrush}" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                                        <Border Background="{StaticResource BgTertiaryBrush}" CornerRadius="4" Padding="8,3"
                                                ToolTipService.ToolTip="{x:Bind WerTooltip}">
                                            <TextBlock Text="{x:Bind WerDisplay}" FontSize="11" Foreground="{StaticResource FgBrush}"/>
                                        </Border>
                                        <Border Background="{StaticResource BgTertiaryBrush}" CornerRadius="4" Padding="8,3">
                                            <TextBlock Text="{x:Bind SpeedDisplay}" FontSize="11" Foreground="{StaticResource FgBrush}"/>
                                        </Border>
                                        <Border Background="{StaticResource BgTertiaryBrush}" CornerRadius="4" Padding="8,3">
                                            <TextBlock Text="{x:Bind SizeDisplay}" FontSize="11" Foreground="{StaticResource FgBrush}"/>
                                        </Border>
                                        <Border Background="{StaticResource BgTertiaryBrush}" CornerRadius="4" Padding="8,3">
                                            <TextBlock Text="{x:Bind LatencyDisplay}" FontSize="11" Foreground="{StaticResource GreenBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <ProgressBar Margin="0,6,0,0" Height="4" Minimum="0" Maximum="100"
                                                 Value="{x:Bind Progress, Mode=OneWay}"
                                                 Visibility="{x:Bind ProgressVisibility, Mode=OneWay}"
                                                 Foreground="{StaticResource AccentBrush}" Background="{StaticResource BgTertiaryBrush}"/>
                                </StackPanel>
                                <Button Grid.Column="1" VerticalAlignment="Top" MinWidth="120"
                                        Style="{StaticResource PrimaryButton}" Padding="12,6" FontSize="12"
                                        Content="{x:Bind ActionText, Mode=OneWay}"
                                        IsEnabled="{x:Bind CanDownload, Mode=OneWay}"
                                        Click="DownloadCard_Click"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Downloads: overall progress -->
            <StackPanel Grid.Row="2" Margin="0,4,0,4" Spacing="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Downloads" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource FgBrush}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="Clear finished" Margin="6,0,0,0"
                            Background="{StaticResource BgTertiaryBrush}" Foreground="{StaticResource FgBrush}"
                            BorderThickness="0" Padding="10,4" FontSize="11"
                            IsEnabled="{x:Bind ViewModel.HasFinishedJobs, Mode=OneWay}"
                            Command="{x:Bind ViewModel.ClearFinishedCommand}"/>
                    <Button Grid.Column="2" Content="Cancel all" Margin="6,0,0,0"
                            Background="{StaticResource BgTertiaryBrush}" Foreground="{StaticResource FgBrush}"
                            BorderThickness="0" Padding="10,4" FontSize="11"
                            IsEnabled="{x:Bind ViewModel.HasActiveJobs, Mode=OneWay}"
                            Command="{x:Bind ViewModel.CancelAllCommand}"/>
                </Grid>
                <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{x:Bind ViewModel.TotalPercent, Mode=OneWay}"
                             Foreground="{StaticResource GreenBrush}" Background="{StaticResource BgTertiaryBrush}"/>
                <TextBlock Text="{x:Bind ViewModel.TotalDetail, Mode=OneWay}" FontSize="11"
                           Foreground="{StaticResource FgSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Downloads: one row per model -->
            <Grid Grid.Row="3">
                <TextBlock Text="Pick one or more models above — they download in parallel, and you can close this window meanwhile."
                           FontSize="11" Foreground="{StaticResource FgSecondaryBrush}" TextWrapping="Wrap"
                           Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}"/>
                <ListView SelectionMode="None" Background="Transparent" ItemsSource="{x:Bind ViewModel.Jobs, Mode=OneWay}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,6"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:DownloadJobViewModel">
                            <Border Background="{StaticResource BgSecondaryBrush}" CornerRadius="6" Padding="10,8">
                                <Grid ColumnSpacing="8" RowSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{x:Bind Title}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource FgBrush}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind StateText, Mode=OneWay}" FontSize="12"
                                               Foreground="{StaticResource FgSecondaryBrush}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                                        <Button Content="Use" Style="{StaticResource PrimaryButton}" Padding="10,3" FontSize="11"
                                                ToolTipService.ToolTip="Switch recognition to this model"
                                                Visibility="{x:Bind UseVisibility, Mode=OneWay}" Click="UseJob_Click"/>
                                        <Button Content="Retry" Background="{StaticResource BgTertiaryBrush}" Foreground="{StaticResource FgBrush}"
                                                BorderThickness="0" Padding="10,3" FontSize="11"
                                                Visibility="{x:Bind RetryVisibility, Mode=OneWay}" Click="RetryJob_Click"/>
                                        <Button Content="Cancel" Background="{StaticResource BgTertiaryBrush}" Foreground="{StaticResource FgBrush}"
                                                BorderThickness="0" Padding="10,3" FontSize="11"
                                                Visibility="{x:Bind CancelVisibility, Mode=OneWay}" Click="CancelJob_Click"/>
                                    </StackPanel>
                                    <ProgressBar Grid.Row="1" Grid.ColumnSpan="3" Height="4" Minimum="0" Maximum="100"
                                                 Value="{x:Bind Percent, Mode=OneWay}" IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}"
                                                 Foreground="{StaticResource AccentBrush}" Background="{StaticResource BgTertiaryBrush}"/>
                                    <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="{x:Bind Detail, Mode=OneWay}" FontSize="11"
                                               Foreground="{StaticResource FgSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="3" Margin="12,6,12,10">
            <TextBlock Text="Downloads continue in the background when this window is closed. Finished models are announced with a notification."
                       FontSize="11" Foreground="{StaticResource FgSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,120,0"/>
            <Button Content="Close" HorizontalAlignment="Right" Background="{StaticResource BgTertiaryBrush}" Foreground="{StaticResource FgBrush}"
                    BorderThickness="0" Padding="16,6" FontSize="12" Click="CloseButton_Click"/>
        </Grid>
    </Grid>
</Window>
