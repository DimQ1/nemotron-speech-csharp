<Window
    x:Class="VoiceType.WinUI.Views.HelpWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="How to use VoiceType">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop/>
    </Window.SystemBackdrop>

    <Grid Background="{StaticResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40" Background="{StaticResource BgSecondaryBrush}">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0,0,0">
                <FontIcon Glyph="&#xE897;" FontSize="16" Foreground="{StaticResource AccentBrush}"/>
                <TextBlock Text="How to use VoiceType" Foreground="{StaticResource FgBrush}"
                           Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="18,12">
            <StackPanel Spacing="14">

                <!-- Quick start -->
                <Border Background="{StaticResource BgSecondaryBrush}" CornerRadius="6" Padding="14">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Quick start" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource FgBrush}"/>
                        <TextBlock Foreground="{StaticResource FgSecondaryBrush}" FontSize="12"
                                   TextWrapping="Wrap" LineHeight="19">
                            <Run Text="1. Press the big " />
                            <Run Text="Start" FontWeight="SemiBold" Foreground="{StaticResource FgBrush}"/>
                            <Run Text=" button (or the Ctrl+Shift+V hotkey) to begin listening."/>
                            <LineBreak/>
                            <Run Text="2. Speak — the recognized text appears live in the window."/>
                            <LineBreak/>
                            <Run Text="3. Press " />
                            <Run Text="Stop" FontWeight="SemiBold" Foreground="{StaticResource FgBrush}"/>
                            <Run Text=" (or Ctrl+Shift+V again) when you're done."/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Text injection -->
                <Border Background="{StaticResource BgSecondaryBrush}" CornerRadius="6" Padding="14">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8C8;" FontSize="14" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text="Typing into other apps (text injection)" FontSize="15"
                                       FontWeight="SemiBold" Foreground="{StaticResource FgBrush}"/>
                        </StackPanel>
                        <TextBlock Foreground="{StaticResource FgSecondaryBrush}" FontSize="12"
                                   TextWrapping="Wrap" LineHeight="19"
                                   Text="Turn on 'Enable text injection', click into any text field in another app, and dictate — VoiceType types the words for you. Press Ctrl+Shift+I to inject the current text manually. 'Pause injection on focus change' stops typing automatically when you switch windows."/>
                    </StackPanel>
                </Border>

                <!-- Hotkeys -->
                <Border Background="{StaticResource BgSecondaryBrush}" CornerRadius="6" Padding="14">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Hotkeys" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource FgBrush}"/>
                        <StackPanel Spacing="5">
                            <TextBlock FontSize="12" Foreground="{StaticResource FgSecondaryBrush}">
                                <Run Text="Ctrl+Shift+V" FontWeight="SemiBold" Foreground="{StaticResource FgBrush}"/>
                                <Run Text="  —  start / stop listening"/>
                            </TextBlock>
                            <TextBlock FontSize="12" Foreground="{StaticResource FgSecondaryBrush}">
                                <Run Text="Ctrl+Shift+M" FontWeight="SemiBold" Foreground="{StaticResource FgBrush}"/>
                                <Run Text="  —  mute / unmute the microphone"/>
                            </TextBlock>
                            <TextBlock FontSize="12" Foreground="{StaticResource FgSecondaryBrush}">
                                <Run Text="Ctrl+Shift+I" FontWeight="SemiBold" Foreground="{StaticResource FgBrush}"/>
                                <Run Text="  —  inject the recognized text now"/>
                            </TextBlock>
                            <TextBlock FontSize="12" Foreground="{StaticResource FgSecondaryBrush}"
                                       TextWrapping="Wrap" Text="Any key or mouse click stops recognition (configurable in Settings)."/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Audio source -->
                <Border Background="{StaticResource BgSecondaryBrush}" CornerRadius="6" Padding="14">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE767;" FontSize="14" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text="Audio source — Mic / Loopback / Mix" FontSize="15"
                                       FontWeight="SemiBold" Foreground="{StaticResource FgBrush}"/>
                        </StackPanel>
                        <TextBlock Foreground="{StaticResource FgSecondaryBrush}" FontSize="12"
                                   TextWrapping="Wrap" LineHeight="19">
                            <Run Text="Mic" FontWeight="SemiBold" Foreground="{StaticResource FgBrush}"/>
                            <Run Text=" captures only your microphone. "/>
                            <Run Text="Loopback" FontWeight="SemiBold" Foreground="{StaticResource FgBrush}"/>
                            <Run Text=" captures only your PC's output sound. "/>
                            <Run Text="Mix" FontWeight="SemiBold" Foreground="{StaticResource FgBrush}"/>
                            <Run Text=" captures both — so VoiceType transcribes what you say AND what you hear (calls, meetings, videos). Mix is the default. Balance the two in the Audio Mixer window."/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Language & models -->
                <Border Background="{StaticResource BgSecondaryBrush}" CornerRadius="6" Padding="14">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Language &amp; models" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource FgBrush}"/>
                        <TextBlock Foreground="{StaticResource FgSecondaryBrush}" FontSize="12"
                                   TextWrapping="Wrap" LineHeight="19"
                                   Text="Pick a recognition language in the main window (auto detects it). Download other speech models or switch precision/performance in Settings → Model → Download. All recognition runs locally on your PC — audio never leaves the device."/>
                    </StackPanel>
                </Border>

                <!-- Privacy -->
                <Border Background="{StaticResource BgSecondaryBrush}" CornerRadius="6" Padding="14">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Privacy &amp; sessions" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource FgBrush}"/>
                        <TextBlock Foreground="{StaticResource FgSecondaryBrush}" FontSize="12"
                                   TextWrapping="Wrap" LineHeight="19"
                                   Text="Recognition is fully offline. Saving sessions to disk is OFF by default; enable it in Settings → Session Recording if you want a history of transcripts (optionally with MP3 audio)."/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource BgSecondaryBrush}" Padding="16,12">
            <Button Content="Got it" Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Right" Padding="20,8" FontSize="13"
                    Click="Close_Click"/>
        </Border>
    </Grid>
</Window>
