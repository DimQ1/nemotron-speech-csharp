<Window
    x:Class="VoiceType.WinUI.Views.VoiceCommandsSettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:VoiceType.WinUI.ViewModels"
    x:DataType="vm:VoiceCommandsSettingsViewModel"
    Title="Voice Commands">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop/>
    </Window.SystemBackdrop>

    <Grid Background="{StaticResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Height="40" Background="{StaticResource BgSecondaryBrush}">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0,0,0">
                <FontIcon Glyph="&#xE720;" Foreground="{StaticResource AccentBrush}"/>
                <TextBlock Text="Voice Commands" Foreground="{StaticResource FgBrush}" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="8,4,8,0">
            <StackPanel Spacing="8" Margin="0,0,0,8">
                <Border Background="{StaticResource BgSecondaryBrush}" CornerRadius="4" Padding="10">
                    <StackPanel Spacing="6">
                        <CheckBox Content="Enable voice command mode" IsChecked="{x:Bind ViewModel.Enabled, Mode=TwoWay}" Style="{StaticResource DarkCheckBox}"/>
                        <TextBlock Text="Commands are recognized separately from dictation. Exact commands react immediately; semantic matching handles flexible phrasing."
                                   Foreground="{StaticResource FgSecondaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                        <TextBlock Text="Semantic model folder" Foreground="{StaticResource FgSecondaryBrush}" FontSize="12"/>
                        <TextBox Text="{x:Bind ViewModel.IntentModelPath, Mode=TwoWay}" Style="{StaticResource DarkTextBox}"/>
                        <TextBlock Text="Confidence threshold" Foreground="{StaticResource FgSecondaryBrush}" FontSize="12"/>
                        <Slider Minimum="0.5" Maximum="1" StepFrequency="0.05" Value="{x:Bind ViewModel.ConfidenceThreshold, Mode=TwoWay}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,6,0"><TextBlock Text="Hysteresis M" Foreground="{StaticResource FgSecondaryBrush}" FontSize="11"/><TextBox Text="{x:Bind ViewModel.HysteresisM, Mode=TwoWay}" Style="{StaticResource DarkTextBox}"/></StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,6,0"><TextBlock Text="Hysteresis N" Foreground="{StaticResource FgSecondaryBrush}" FontSize="11"/><TextBox Text="{x:Bind ViewModel.HysteresisN, Mode=TwoWay}" Style="{StaticResource DarkTextBox}"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Targets/app" Foreground="{StaticResource FgSecondaryBrush}" FontSize="11"/><TextBox Text="{x:Bind ViewModel.HistoryPerProcess, Mode=TwoWay}" Style="{StaticResource DarkTextBox}"/></StackPanel>
                        </Grid>
                        <CheckBox Content="Remember target windows and fields" IsChecked="{x:Bind ViewModel.RememberTargets, Mode=TwoWay}" Style="{StaticResource DarkCheckBox}"/>
                        <CheckBox Content="Ask before changing an ambiguous target" IsChecked="{x:Bind ViewModel.ConfirmTargetSwitch, Mode=TwoWay}" Style="{StaticResource DarkCheckBox}"/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource BgSecondaryBrush}" CornerRadius="4" Padding="10">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Application Aliases" Foreground="{StaticResource FgBrush}" FontWeight="SemiBold"/>
                        <TextBlock Text="One line per process: process = spoken name, alternate name" Foreground="{StaticResource FgSecondaryBrush}" FontSize="11"/>
                        <TextBox Text="{x:Bind ViewModel.AliasesText, Mode=TwoWay}" Style="{StaticResource DarkTextBox}" AcceptsReturn="True" MinHeight="72" TextWrapping="Wrap"/>
                        <TextBlock Text="Custom taxonomy file (optional)" Foreground="{StaticResource FgSecondaryBrush}" FontSize="12"/>
                        <TextBox Text="{x:Bind ViewModel.CustomIntentsFile, Mode=TwoWay}" Style="{StaticResource DarkTextBox}"/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource BgSecondaryBrush}" CornerRadius="4" Padding="10">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Applications and Paths" Foreground="{StaticResource FgBrush}" FontWeight="SemiBold"/>
                        <TextBlock Text="Add an executable when an application is not detected automatically. Its process name and aliases will be used for voice targeting."
                                   Foreground="{StaticResource FgSecondaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                        <TextBox PlaceholderText="Display name" Text="{x:Bind ViewModel.NewApplicationName, Mode=TwoWay}" Style="{StaticResource DarkTextBox}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox PlaceholderText="Path to .exe" Text="{x:Bind ViewModel.NewApplicationPath, Mode=TwoWay}" Style="{StaticResource DarkTextBox}"/>
                            <Button Grid.Column="1" Content="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Margin="8,0,0,0" Command="{x:Bind ViewModel.BrowseApplicationCommand}" ToolTipService.ToolTip="Choose executable"/>
                        </Grid>
                        <TextBox PlaceholderText="Aliases, comma separated" Text="{x:Bind ViewModel.NewApplicationAliases, Mode=TwoWay}" Style="{StaticResource DarkTextBox}"/>
                        <Button Content="Add application" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Command="{x:Bind ViewModel.AddApplicationCommand}"/>
                        <ListView ItemsSource="{x:Bind ViewModel.Applications}" SelectionMode="None" Background="Transparent" BorderThickness="0" Padding="0" MaxHeight="180">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource FgBrush}"/>
                                            <TextBlock Text="{Binding ExecutablePath}" Foreground="{StaticResource FgSecondaryBrush}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" Tag="{Binding}" Click="RemoveApplication_Click" ToolTipService.ToolTip="Remove application"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource BgSecondaryBrush}" CornerRadius="4" Padding="10">
                    <StackPanel Spacing="6">
                        <Grid><TextBlock Text="Detected applications" Foreground="{StaticResource FgBrush}" FontWeight="SemiBold"/><Button Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Right" Command="{x:Bind ViewModel.RefreshCatalogueCommand}" ToolTipService.ToolTip="Refresh application catalogue"/></Grid>
                        <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" Foreground="{StaticResource FgSecondaryBrush}" FontSize="11"/>
                        <ListView ItemsSource="{x:Bind ViewModel.DiscoveredApplications}" SelectionMode="None" Background="Transparent" BorderThickness="0" Padding="0" MaxHeight="200">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource FgBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="12,8">
            <Button Content="Cancel" Command="{x:Bind ViewModel.CancelCommand}"/>
            <Button Content="Save" Style="{StaticResource PrimaryButton}" Command="{x:Bind ViewModel.SaveCommand}"/>
        </StackPanel>
    </Grid>
</Window>