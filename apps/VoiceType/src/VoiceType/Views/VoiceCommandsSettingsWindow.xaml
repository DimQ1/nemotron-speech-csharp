<Window x:Class="VoiceType.Views.VoiceCommandsSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Voice Commands Settings"
        Width="620" Height="720"
        MinWidth="520" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BgBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,16">

                <!-- ── Master toggle ── -->
                <GroupBox Header="Voice Commands Mode" Style="{StaticResource DarkGroupBox}">
                    <StackPanel>
                        <CheckBox IsChecked="{Binding Enabled}"
                                  Content="Enable voice commands (intent mode)"
                                  Foreground="{StaticResource FgBrush}" FontSize="13" Margin="0,0,0,6"/>
                        <TextBlock Text="When off, dictation works exactly as before — no model is loaded."
                                   Foreground="{StaticResource FgSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding ModelStatus, Mode=OneWay}"
                                   Foreground="{StaticResource FgSecondaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>
                </GroupBox>

                <!-- ── Intent model ── -->
                <GroupBox Header="Intent Model" Style="{StaticResource DarkGroupBox}">
                    <StackPanel>
                        <TextBlock Text="Model Folder (MiniLM INT8 ONNX)" Foreground="{StaticResource FgSecondaryBrush}" FontSize="12" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding IntentModelPath, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DarkTextBox}" Margin="0,0,0,4"/>
                        <TextBlock Text="Empty = L0 heuristics only. Expected files: onnx\model_int8.onnx, sentencepiece.bpe.model"
                                   Foreground="{StaticResource FgSecondaryBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,8"/>

                        <TextBlock Text="{Binding ConfidenceThreshold, StringFormat='Confidence threshold: {0:0.00}'}" Foreground="{StaticResource FgSecondaryBrush}" FontSize="12" Margin="0,0,0,2"/>
                        <Slider Minimum="0.5" Maximum="1.0" TickFrequency="0.05"
                                Value="{Binding ConfidenceThreshold, UpdateSourceTrigger=PropertyChanged}"
                                Margin="0,0,0,8"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Hysteresis M" Foreground="{StaticResource FgSecondaryBrush}" FontSize="12" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding HysteresisM, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" Margin="0,0,8,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Hysteresis N" Foreground="{StaticResource FgSecondaryBrush}" FontSize="12" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding HysteresisN, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Custom intents.json (optional)" Foreground="{StaticResource FgSecondaryBrush}" FontSize="12" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding CustomIntentsFile, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DarkTextBox}"/>
                    </StackPanel>
                </GroupBox>

                <!-- ── Target memory ── -->
                <GroupBox Header="Target Memory" Style="{StaticResource DarkGroupBox}">
                    <StackPanel>
                        <CheckBox IsChecked="{Binding RememberTargets}"
                                  Content="Remember windows / fields I type into"
                                  Foreground="{StaticResource FgBrush}" FontSize="13" Margin="0,0,0,6"/>
                        <CheckBox IsChecked="{Binding ConfirmTargetSwitch}"
                                  Content="Ask which field when ambiguous"
                                  Foreground="{StaticResource FgBrush}" FontSize="13" Margin="0,0,0,6"/>
                        <TextBlock Text="History per app" Foreground="{StaticResource FgSecondaryBrush}" FontSize="12" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding HistoryPerProcess, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" Margin="0,0,0,8"/>

                        <TextBlock Text="App aliases (process = spoken names, one per line)" Foreground="{StaticResource FgSecondaryBrush}" FontSize="12" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding AppAliasesText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DarkTextBox}" AcceptsReturn="True" MinHeight="72"
                                 VerticalScrollBarVisibility="Auto" Margin="0,0,0,8"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Remembered targets" Foreground="{StaticResource FgSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Refresh" Margin="8,0,0,0" Padding="10,4"
                                    Background="{StaticResource BgTertiaryBrush}" Foreground="{StaticResource FgBrush}"
                                    BorderThickness="0" Cursor="Hand" Command="{Binding RefreshHistoryCommand}"/>
                            <Button Grid.Column="2" Content="Clear" Margin="8,0,0,0" Padding="10,4"
                                    Background="{StaticResource BgTertiaryBrush}" Foreground="{StaticResource FgBrush}"
                                    BorderThickness="0" Cursor="Hand" Command="{Binding ClearHistoryCommand}"/>
                        </Grid>
                        <ListBox ItemsSource="{Binding Targets}" MinHeight="80" MaxHeight="160" Margin="0,6,0,0"
                                 Background="{StaticResource BgSecondaryBrush}" BorderThickness="0" Foreground="{StaticResource FgBrush}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Foreground="{StaticResource FgBrush}" FontSize="11">
                                        <Run Text="{Binding DisplayLabel, Mode=OneWay}"/>
                                        <Run Text="{Binding UseCount, Mode=OneWay, StringFormat='  (×{0})'}" Foreground="{StaticResource FgSecondaryBrush}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Save" Width="96" Margin="0,0,8,0" Padding="0,8" IsDefault="True"
                    Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0"
                    Cursor="Hand" Click="Save_Click"/>
            <Button Content="Cancel" Width="96" Padding="0,8" IsCancel="True"
                    Background="{StaticResource BgTertiaryBrush}" Foreground="{StaticResource FgBrush}"
                    BorderThickness="0" Cursor="Hand" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
