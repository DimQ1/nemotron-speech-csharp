<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <!-- net10.0-windows10.0.26100 = WinAppSDK (WinUI 3) head for parity testing on Windows;
         net10.0-desktop = Skia head (Linux X11 primary, also Windows/macOS);
         net10.0-android = Android head (Skia). The Microsoft.ML.OnnxRuntime package ships the
         android native (onnxruntime.aar), so the recognizers run on the CPU of the device.
         The android head is excluded when publishing for a desktop RID: a desktop RID
         (linux-x64 / win-x64 / osx-arm64) would make the android head resolve a non-existent
         Mono runtime pack during restore (dotnet publish -r <desktop-rid>). The android head
         is published with its own TFM (no -r). -->
    <TargetFrameworks>net10.0-windows10.0.26100;net10.0-desktop</TargetFrameworks>
    <TargetFrameworks Condition="'$(RuntimeIdentifier)' != 'linux-x64' and '$(RuntimeIdentifier)' != 'win-x64' and '$(RuntimeIdentifier)' != 'osx-arm64'">$(TargetFrameworks);net10.0-android</TargetFrameworks>
    <!-- iOS head, opt-in: -p:UnoIosOnly=true builds ONLY net10.0-ios (build with -f net10.0-ios, never with
         -p:TargetFrameworks: a global property leaks into every referenced library). It is not part of the default
         set because the iOS target needs the ios workload and an Xcode, which only a Mac (or a machine with the
         workload and a paired Mac) has; the CI job `ios` in uno-publish.yml sets it. -->
    <TargetFrameworks Condition="'$(UnoIosOnly)' == 'true'">net10.0-ios</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>

    <!-- Display name -->
    <ApplicationTitle>VoiceType</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>com.companyname.voicetype-uno</ApplicationId>
    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Package Publisher -->
    <ApplicationPublisher>VoiceType</ApplicationPublisher>
    <!-- Package Description -->
    <Description>VoiceType — on-device speech-to-text dictation.</Description>

    <!--
      UnoFeatures are used to quickly add and manage features enabled for your app.
      https://aka.platform.uno/singleproject-features
    -->
    <UnoFeatures>
      Hosting;
      Mvvm;
      SkiaRenderer;
      Toolkit;
    </UnoFeatures>

    <!-- Packaging/ holds installer inputs (Linux .deb files, the macOS bundle sources): the Uno SDK would otherwise copy
         every *.png in the project (Packaging/macOS/AppIcon.png) into the app output of every head. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Packaging/**</DefaultItemExcludes>

    <!-- Match repository conventions -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.26100'">
    <DefineConstants>$(DefineConstants);VOICE_TYPE_WINDOWS</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
    <!-- ONNX Runtime AAR declares minSdk 24 (uses APIs not available below);
         align the app's minSdk with the library instead of overrideLibrary. -->
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-ios'">
    <!-- Uno 6 renders with Skia on UIKit (UnoPlatformHostBuilder.UseAppleUIKit, Platforms/iOS/Main.iOS.cs).
         The ONNX Runtime iOS xcframework is linked statically by the NuGet package's own targets (CoreML weak). -->
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <!-- Unsigned by default (CI, simulator, compile checks). A signed build passes EnableCodeSigning=true plus the
         CodesignKey / CodesignProvision properties (see docs/ci.md, iOS). -->
    <EnableCodeSigning Condition="'$(EnableCodeSigning)' == ''">false</EnableCodeSigning>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-ios'">
    <!-- WASAPI playback is built on the NAudio package that iOS does not link (see the NAudio3 reference below). -->
    <Compile Remove="Services\Playback\WasapiPcmOutput.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Uno SDK emits no version attributes; the display version is read back at
         runtime for the History version metadata (app.version). -->
    <AssemblyMetadata Include="ApplicationDisplayVersion" Value="$(ApplicationDisplayVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!-- UI-free core: settings store, model discovery, transcript coordination.
         Plain net10.0 so the logic is unit-tested without the Uno runtime. -->
    <ProjectReference Include="..\VoiceType.Uno.Core\VoiceType.Uno.Core.csproj" />
    <!-- Speech recognition contracts (IAudioSource, IStreamingSpeechRecognizer, ...) -->
    <ProjectReference Include="..\..\..\..\libraries\SpeechLib\src\SpeechLib\SpeechLib.csproj" />
    <!-- Single recognition library: the Nemotron, Parakeet TDT, Qwen3-ASR and VibeVoice providers
         on plain ONNX Runtime (CPU execution provider on Linux and Android). -->
    <ProjectReference Include="..\..\..\..\libraries\SpeechLib\src\SpeechLib.Providers\SpeechLib.Providers.csproj" />
    <!-- Shared model catalog for the downloader (WinUI + Uno) -->
    <ProjectReference Include="..\..\..\..\libraries\SpeechLib\src\SpeechLib.ModelDownload\SpeechLib.ModelDownload.csproj" />
    <!-- Global hotkeys: XDG GlobalShortcuts portal on Linux (Wayland + X11) -->
    <ProjectReference Include="..\..\..\..\libraries\VoiceType.Hotkeys\VoiceType.Hotkeys.csproj" />
    <!-- Live translation via LiteRT-LM server (OpenAI-compatible HTTP endpoint;
         pure managed code — works on Linux, unlike the native LiteRT backend) -->
    <ProjectReference Include="..\..\..\..\libraries\SpeechLib\src\SpeechLib.LiteRT\SpeechLib.LiteRT.csproj" />
    <!-- In-process LiteRT-LM translation (no sidecar): LiteRtLmSharp runtime packages
         are RID-selected (win-x64 / linux-x64), so the native backend also works on Linux -->
    <ProjectReference Include="..\..\..\..\libraries\SpeechLib\src\SpeechLib.LiteRT.Native\SpeechLib.LiteRT.Native.csproj" />
    <!-- Windows audio capture (WASAPI) via NAudio 3.0.1 — portable TFM (net10.0), so
         it links into both heads; PulseAudio is selected at runtime on Linux. -->
    <!-- Not on iOS: it is Windows audio (WASAPI) plus NAudio.Lame, and the device AOT compiler fails on NAudio.Lame.dll. -->
    <ProjectReference Include="..\..\..\..\libraries\SpeechLib\src\SpeechLib.Audio.NAudio3\SpeechLib.Audio.NAudio3.csproj"
                      Condition="'$(TargetFramework)' != 'net10.0-ios'" />
    <!-- Recordings history audio: Ogg Opus / WAV writers, offline reader, streaming playback reader -->
    <ProjectReference Include="..\..\..\..\libraries\SpeechLib\src\SpeechLib.AudioStorage\SpeechLib.AudioStorage.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'osx-arm64'">
    <!-- macOS (Apple silicon) publish: the LiteRT-LM native runtime for the in-process Gemma engine. Referenced here and
         only for this RID, so other builds do not need the package in the folder feed; the macOS CI job fetches it with
         tools/scripts/fetch-litertlmsharp-feed.ps1 -Rid osx-arm64. Audio capture on macOS is the voicetype-audio helper
         that build-macos-app.sh compiles into VoiceType.app (Packaging/macOS). The version is in ..\Directory.Packages.props
         (central package management of the Uno SDK). -->
    <PackageReference Include="LiteRtLmSharp.runtime.osx-arm64" />
  </ItemGroup>

</Project>
