<Page x:Class="VoiceType.Uno.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:VoiceType.Uno"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid Padding="16" RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Status and quick settings -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
        <TextBlock Text="{x:Bind ViewModel.RecordingIndicator, Mode=OneWay}" Opacity="0.7" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
          Margin="8,0,8,0" VerticalAlignment="Center">
        <TextBlock Text="Language" Opacity="0.7" VerticalAlignment="Center" />
        <ComboBox Width="112"
          ItemsSource="{x:Bind ViewModel.LanguageOptions}"
          SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}" />
      </StackPanel>
      <Button Grid.Column="2" Content="Help" Click="Help_Click" />
      <Button Grid.Column="3" Content="Settings" Click="Settings_Click" />
    </Grid>

    <!-- Model status -->
    <StackPanel Grid.Row="1" Spacing="4">
      <TextBlock Text="{x:Bind ViewModel.ModelStatusText, Mode=OneWay}"
                 Opacity="0.6" FontSize="12" />
      <ProgressBar Height="4"
                   IsIndeterminate="{x:Bind ViewModel.IsModelDownloading, Mode=OneWay}"
                   Value="{x:Bind ViewModel.DownloadProgress, Mode=OneWay}" />
    </StackPanel>

    <!-- Transcript -->
    <ScrollViewer Grid.Row="2" BorderThickness="1"
                  BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Padding="8">
      <TextBlock Text="{x:Bind ViewModel.FloatingText, Mode=OneWay}"
                 TextWrapping="Wrap" IsTextSelectionEnabled="True" />
    </ScrollViewer>

    <!-- Controls -->
    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
      <Button Content="{x:Bind ViewModel.RecordButtonText, Mode=OneWay}"
              Command="{x:Bind ViewModel.ToggleCommand}"
              Style="{StaticResource AccentButtonStyle}" />
      <Button Content="Mute"
              Command="{x:Bind ViewModel.ToggleMuteCommand}"
              IsEnabled="{x:Bind ViewModel.IsRecording, Mode=OneWay}" />
      <Button Content="Copy"
              Command="{x:Bind ViewModel.CopyCommand}" />
      <ToggleButton Content="Inject text"
                    IsChecked="{x:Bind ViewModel.IsTextInjectionEnabled, Mode=TwoWay}" />
    </StackPanel>
  </Grid>
</Page>
