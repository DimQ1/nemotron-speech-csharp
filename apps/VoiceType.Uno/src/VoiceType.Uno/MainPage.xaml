<Page x:Class="VoiceType.Uno.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:VoiceType.Uno"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid Padding="16" RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Status row -->
    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" VerticalAlignment="Center" />
      <TextBlock Text="{x:Bind ViewModel.RecordingIndicator, Mode=OneWay}"
                 VerticalAlignment="Center" Opacity="0.7" />
    </StackPanel>

    <!-- Model status -->
    <TextBlock Grid.Row="1"
               Text="{x:Bind ViewModel.ModelStatusText, Mode=OneWay}"
               Opacity="0.6" FontSize="12" />

    <!-- Transcript -->
    <ScrollViewer Grid.Row="2" BorderThickness="1"
                  BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Padding="8">
      <TextBlock Text="{x:Bind ViewModel.FloatingText, Mode=OneWay}"
                 TextWrapping="Wrap" IsTextSelectionEnabled="True" />
    </ScrollViewer>

    <!-- Controls -->
    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
      <Button Content="{x:Bind ViewModel.RecordButtonText, Mode=OneWay}"
              Command="{x:Bind ViewModel.ToggleCommand}"
              Style="{StaticResource AccentButtonStyle}" />
      <Button Content="Mute"
              Command="{x:Bind ViewModel.ToggleMuteCommand}"
              IsEnabled="{x:Bind ViewModel.IsRecording, Mode=OneWay}" />
      <Button Content="Copy"
              Command="{x:Bind ViewModel.CopyCommand}" />
      <ToggleButton Content="Inject text"
                    IsChecked="{x:Bind ViewModel.IsTextInjectionEnabled, Mode=TwoWay}" />
    </StackPanel>
  </Grid>
</Page>
