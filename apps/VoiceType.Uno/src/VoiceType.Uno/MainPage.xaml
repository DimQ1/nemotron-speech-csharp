<Page x:Class="VoiceType.Uno.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:VoiceType.Uno"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid Padding="16,16,16,8" RowSpacing="6">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="200" x:Name="TranslationRow" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Status and quick settings. On narrow phone screens the row is wider
         than the viewport — wrap it in a horizontal ScrollViewer so the combo
         boxes and the Downloads/Help/Settings buttons stay reachable. -->
    <ScrollViewer HorizontalScrollMode="Enabled"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollMode="Disabled"
                  VerticalScrollBarVisibility="Disabled">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
        <TextBlock Text="{x:Bind ViewModel.RecordingIndicator, Mode=OneWay}" Opacity="0.7" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
          Margin="8,0,8,0" VerticalAlignment="Center">
        <TextBlock Text="Language" Opacity="0.7" VerticalAlignment="Center" />
        <ComboBox Width="112"
          ItemsSource="{x:Bind ViewModel.LanguageOptions}"
          SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}" />
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
          Margin="0,0,8,0" VerticalAlignment="Center"
          Visibility="{x:Bind ViewModel.IsTranslationVisible, Mode=OneWay}">
        <TextBlock Text="Translate to" Opacity="0.7" VerticalAlignment="Center" />
        <ComboBox Width="112"
          ItemsSource="{x:Bind ViewModel.LanguageOptions}"
          SelectedItem="{x:Bind ViewModel.TranslationTargetLanguage, Mode=TwoWay}" />
      </StackPanel>
      <Button Grid.Column="3" Content="Downloads" Click="Downloads_Click" Margin="10,0,0,0" />
      <Button Grid.Column="4" Content="Help" Click="Help_Click" Margin="10,0,0,0" />
      <Button Grid.Column="5" Content="Settings" Click="Settings_Click" Margin="10,0,0,0" />
    </Grid>
    </ScrollViewer>

    <!-- ASR model missing banner (matches the translation banner style) -->
    <Border Grid.Row="1"
            Visibility="{x:Bind ViewModel.IsAsrModelBannerVisible, Mode=OneWay}"
            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
            BorderThickness="1"
            BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
            Padding="8" CornerRadius="4">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="ℹ" VerticalAlignment="Center" />
        <TextBlock Text="{x:Bind ViewModel.AsrModelBannerText, Mode=OneWay}"
                   VerticalAlignment="Center" TextWrapping="Wrap" />
        <Button Content="Download" Click="DownloadAsrModel_Click" VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- Translation model missing banner -->
    <Border Grid.Row="2"
            Visibility="{x:Bind ViewModel.IsTranslationModelBannerVisible, Mode=OneWay}"
            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
            BorderThickness="1"
            BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
            Padding="8" CornerRadius="4">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="ℹ" VerticalAlignment="Center" />
        <TextBlock Text="{x:Bind ViewModel.TranslationModelBannerText, Mode=OneWay}"
                   VerticalAlignment="Center" TextWrapping="Wrap" />
        <Button Content="Download" Click="DownloadTranslationModel_Click" VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- Download queue aggregate progress -->
    <StackPanel Grid.Row="3" Spacing="4"
                Visibility="{x:Bind ViewModel.IsQueueProgressVisible, Mode=OneWay}">
      <TextBlock Text="{x:Bind ViewModel.QueueProgressText, Mode=OneWay}"
                 Opacity="0.7" FontSize="12" />
      <ProgressBar Height="4"
                   IsIndeterminate="{x:Bind ViewModel.IsModelDownloading, Mode=OneWay}"
                   Value="{x:Bind ViewModel.QueueProgressPercent, Mode=OneWay}" />
    </StackPanel>

    <!-- Model status -->
    <StackPanel Grid.Row="4" Spacing="4">
      <TextBlock Text="{x:Bind ViewModel.ModelStatusText, Mode=OneWay}"
                 Opacity="0.6" FontSize="12" />
    </StackPanel>

<!-- Transcript (resizable, shares space with translation).
         Read-only by default; editable when the Manual input chip is on so text
         typed by hand can be translated without dictation. -->
    <ScrollViewer x:Name="TranscriptScroll" Grid.Row="5" BorderThickness="1"
                   BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Padding="8">
      <TextBox Text="{x:Bind ViewModel.FloatingText, Mode=TwoWay}"
               IsReadOnly="{x:Bind ViewModel.IsTranscriptReadOnly, Mode=OneWay}"
               AcceptsReturn="True"
               TextWrapping="Wrap"
               BorderThickness="0"
               Background="Transparent"
               PlaceholderText="Transcript — enable Manual input to type text for translation" />
    </ScrollViewer>

    <!-- Draggable divider between transcript and translation (wide grab area) -->
    <Border Grid.Row="6"
            Height="24"
            Background="Transparent"
            Visibility="{x:Bind ViewModel.IsTranslationVisible, Mode=OneWay}"
            PointerPressed="Divider_PointerPressed"
            PointerMoved="Divider_PointerMoved"
            PointerReleased="Divider_PointerReleased"
            PointerCaptureLost="Divider_PointerReleased">
      <Grid>
        <Border Height="4"
                VerticalAlignment="Center"
                Background="{ThemeResource ControlStrokeColorDefaultBrush}"
                CornerRadius="2" />
        <!-- Grip dots so the divider reads as a draggable handle -->
        <StackPanel Orientation="Horizontal" Spacing="4"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
          <Ellipse Width="4" Height="4"
                   Fill="{ThemeResource ControlStrokeColorDefaultBrush}" />
          <Ellipse Width="4" Height="4"
                   Fill="{ThemeResource ControlStrokeColorDefaultBrush}" />
          <Ellipse Width="4" Height="4"
                   Fill="{ThemeResource ControlStrokeColorDefaultBrush}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Live translation (resizable height via the divider above) -->
    <Border Grid.Row="7"
            Visibility="{x:Bind ViewModel.IsTranslationVisible, Mode=OneWay}"
            BorderThickness="1"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
            Padding="8"
            MinHeight="80">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="{x:Bind ViewModel.TranslationStatusText, Mode=OneWay}"
                   Opacity="0.6" FontSize="12" />
        <ScrollViewer x:Name="TranslationScroll" Grid.Row="1">
          <TextBlock Text="{x:Bind ViewModel.TranslatedText, Mode=OneWay}"
                     TextWrapping="Wrap" IsTextSelectionEnabled="True" />
        </ScrollViewer>
      </Grid>
    </Border>

    <!-- Controls. Six buttons do not fit on a phone-width viewport, so the
         row scrolls horizontally; on narrow screens the buttons also shrink to
         a smaller MinWidth via utu:Responsive. Touch targets stay >=44px. -->
    <ScrollViewer Grid.Row="8"
                  HorizontalScrollMode="Enabled"
                  HorizontalScrollBarVisibility="Hidden"
                  VerticalScrollMode="Disabled"
                  VerticalScrollBarVisibility="Disabled">
    <StackPanel Orientation="Horizontal" Spacing="{utu:Responsive Narrow=8, Normal=12}" HorizontalAlignment="Center">
      <Button Content="{x:Bind ViewModel.RecordButtonText, Mode=OneWay}"
              Command="{x:Bind ViewModel.ToggleCommand}"
              Style="{StaticResource AccentButtonStyle}"
              MinWidth="{utu:Responsive Narrow=88, Normal=96}" Padding="16,8" />
      <Button Content="Mute"
              Command="{x:Bind ViewModel.ToggleMuteCommand}"
              IsEnabled="{x:Bind ViewModel.IsRecording, Mode=OneWay}"
              MinWidth="{utu:Responsive Narrow=64, Normal=80}" Padding="16,8" />
      <Button Content="Copy"
              Command="{x:Bind ViewModel.CopyCommand}"
              MinWidth="{utu:Responsive Narrow=64, Normal=80}" Padding="16,8" />
      <ToggleButton Content="Inject text"
                    IsChecked="{x:Bind ViewModel.IsTextInjectionEnabled, Mode=TwoWay}"
                    MinWidth="{utu:Responsive Narrow=96, Normal=110}" Padding="16,8" />
      <ToggleButton Content="Translate"
                    IsChecked="{x:Bind ViewModel.IsTranslationEnabled, Mode=TwoWay}"
                    MinWidth="{utu:Responsive Narrow=96, Normal=110}" Padding="16,8" />
      <!-- Chip: manual keyboard input mode for the transcript field.
           Off by default (read-only transcript driven by speech). -->
      <ToggleButton Content="Manual input"
                    IsChecked="{x:Bind ViewModel.IsManualInputEnabled, Mode=TwoWay}"
                    MinWidth="{utu:Responsive Narrow=104, Normal=120}" Padding="16,8" />
    </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
