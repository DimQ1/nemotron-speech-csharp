<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup rules for Android 6–11 (android:fullBackupContent).
     Recordings, transcripts, chats and the job queue are private conversations: they must
     never leave the device through Google Drive backup (design voicetype-uno-history §6.5).
     Models and temp files are excluded too: they are large, re-downloadable and would push
     the backup past its 25 MB quota (which disables backup of the settings as well).
     AppPaths.DataRoot = LocalApplicationData/VoiceType; on .NET for Android that is
     files/.local/share/VoiceType. The second set covers a files/VoiceType root. -->
<full-backup-content>
  <exclude domain="file" path=".local/share/VoiceType/sessions" />
  <exclude domain="file" path=".local/share/VoiceType/chats" />
  <exclude domain="file" path=".local/share/VoiceType/jobs" />
  <exclude domain="file" path=".local/share/VoiceType/trash" />
  <exclude domain="file" path=".local/share/VoiceType/models" />
  <exclude domain="file" path=".local/share/VoiceType/temp" />
  <exclude domain="file" path="VoiceType/sessions" />
  <exclude domain="file" path="VoiceType/chats" />
  <exclude domain="file" path="VoiceType/jobs" />
  <exclude domain="file" path="VoiceType/trash" />
  <exclude domain="file" path="VoiceType/models" />
  <exclude domain="file" path="VoiceType/temp" />
</full-backup-content>
