<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Microphone capture for dictation (runtime permission, requested via AudioRecord path) -->
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <!-- Network access for model downloads and the HTTP translation backend -->
  <uses-permission android:name="android.permission.INTERNET" />
  <!-- Post notifications (Android 13+), used for recording status -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <application android:allowBackup="true" android:supportsRtl="true"></application>
</manifest>
