<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Microphone capture for dictation (runtime permission, requested via AudioRecord path) -->
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <!-- Network access for model downloads and the HTTP translation backend -->
  <uses-permission android:name="android.permission.INTERNET" />
  <!-- Post notifications (Android 13+), used for recording status -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- Keep recording with the screen off / another app in front: RecordingService is a
       foreground service of type "microphone" holding a partial wake lock -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <!-- Auto Backup stays on for settings, but recordings, transcripts, chats, the job queue
       and models are excluded (Resources/xml/backup_rules.xml up to Android 11,
       data_extraction_rules.xml from Android 12). -->
  <application android:allowBackup="true"
               android:fullBackupContent="@xml/backup_rules"
               android:dataExtractionRules="@xml/data_extraction_rules"
               android:supportsRtl="true"></application>
</manifest>
