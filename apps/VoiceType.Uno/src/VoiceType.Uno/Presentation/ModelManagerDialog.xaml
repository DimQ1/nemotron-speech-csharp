<ContentDialog x:Class="VoiceType.Uno.Presentation.ModelManagerDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:presentation="using:VoiceType.Uno.Presentation"
               Title="Speech models"
               CloseButtonText="Close"
               DefaultButton="Close">
  <ScrollViewer MaxHeight="640" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="10" Padding="4">

      <!-- Which model to pick, answered up front -->
      <Border Background="{ThemeResource SystemControlBackgroundAltHighBrush}" Padding="12">
        <StackPanel Spacing="6">
          <TextBlock Text="Which model should I download?" FontWeight="SemiBold" />
          <TextBlock Text="{x:Bind ViewModel.RecommendationText, Mode=OneWay}"
                     FontSize="12" TextWrapping="Wrap" />
          <TextBlock Text="{x:Bind ViewModel.AccuracyLeaderText, Mode=OneWay}"
                     FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
          <TextBlock Text="{x:Bind ViewModel.SpeedLeaderText, Mode=OneWay}"
                     FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
          <TextBlock Text="{x:Bind ViewModel.SizeLeaderText, Mode=OneWay}"
                     FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- What is installed right now -->
      <StackPanel Spacing="2">
        <TextBlock Text="{x:Bind ViewModel.ActiveModelText, Mode=OneWay}"
                   FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="{x:Bind ViewModel.InstalledText, Mode=OneWay}"
                   FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
        <TextBlock Text="{x:Bind ViewModel.StorageText, Mode=OneWay}"
                   FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
        <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                   FontSize="12" TextWrapping="Wrap" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Refresh" Click="Refresh_Click" />
        <Button Content="Cancel downloads" Click="CancelAll_Click" />
      </StackPanel>

      <!-- One card per catalog model -->
      <ItemsControl ItemsSource="{x:Bind ViewModel.Cards}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="presentation:ModelCardViewModel">
            <Border BorderThickness="1"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    Padding="12" CornerRadius="6" Margin="0,0,0,10">
              <StackPanel Spacing="6">

                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" />

                <!-- What the variant is + why it is (or is not) the pick -->
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Border BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                          CornerRadius="4" Padding="6,2">
                    <TextBlock Text="{x:Bind PrecisionChip}" FontSize="11" />
                  </Border>
                  <Border BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                          CornerRadius="4" Padding="6,2">
                    <TextBlock Text="{x:Bind WindowChip}" FontSize="11" />
                  </Border>
                  <Border BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                          CornerRadius="4" Padding="6,2"
                          Visibility="{x:Bind ShowRecommendedBadge}">
                    <TextBlock Text="★ recommended" FontSize="11" FontWeight="SemiBold" />
                  </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Border BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                          CornerRadius="4" Padding="6,2"
                          Visibility="{x:Bind IsInstalled, Mode=OneWay}">
                    <TextBlock Text="installed" FontSize="11" />
                  </Border>
                  <Border BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                          CornerRadius="4" Padding="6,2"
                          Visibility="{x:Bind IsInUse, Mode=OneWay}">
                    <TextBlock Text="● in use" FontSize="11" FontWeight="SemiBold" />
                  </Border>
                  <Border BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                          CornerRadius="4" Padding="6,2"
                          Visibility="{x:Bind IsMostAccurate}">
                    <TextBlock Text="most accurate" FontSize="11" />
                  </Border>
                  <Border BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                          CornerRadius="4" Padding="6,2"
                          Visibility="{x:Bind IsFastest}">
                    <TextBlock Text="fastest" FontSize="11" />
                  </Border>
                  <Border BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                          CornerRadius="4" Padding="6,2"
                          Visibility="{x:Bind IsSmallest}">
                    <TextBlock Text="smallest" FontSize="11" />
                  </Border>
                </StackPanel>

                <TextBlock Text="{x:Bind Tagline}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
                <TextBlock Text="{x:Bind Description}" FontSize="12" Opacity="0.75" TextWrapping="Wrap" />

                <!-- Measured comparison, one line per property -->
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                  <TextBlock Text="Accuracy" FontSize="12" Opacity="0.7" />
                  <TextBlock Text="{x:Bind AccuracyText}" FontSize="12" />
                  <TextBlock Text="{x:Bind AccuracyStars}" FontSize="12" />
                </StackPanel>
                <TextBlock Text="{x:Bind AccuracyDetailText}" FontSize="11" Opacity="0.7" TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="Speed" FontSize="12" Opacity="0.7" />
                  <TextBlock Text="{x:Bind SpeedText}" FontSize="12" />
                  <TextBlock Text="{x:Bind SpeedStars}" FontSize="12" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="Download" FontSize="12" Opacity="0.7" />
                  <TextBlock Text="{x:Bind SizeText}" FontSize="12" />
                  <TextBlock Text="{x:Bind SizeStars}" FontSize="12" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{x:Bind LatencyText}" FontSize="11" Opacity="0.7" />
                  <TextBlock Text="·" FontSize="11" Opacity="0.7" />
                  <TextBlock Text="{x:Bind UseCaseText}" FontSize="11" Opacity="0.7" />
                </StackPanel>

                <ProgressBar Height="4" Margin="0,4,0,0" Maximum="100"
                             Value="{x:Bind Progress, Mode=OneWay}"
                             Visibility="{x:Bind IsDownloading, Mode=OneWay}" />
                <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" FontSize="11" Opacity="0.7" TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0"
                            Visibility="{x:Bind IsIdle, Mode=OneWay}">
                  <Button Content="{x:Bind ActionText, Mode=OneWay}"
                          Click="DownloadCard_Click"
                          IsEnabled="{x:Bind CanDownload, Mode=OneWay}" />
                  <Button Content="Use" Click="UseCard_Click"
                          IsEnabled="{x:Bind CanUse, Mode=OneWay}" />
                  <Button Content="Delete" Click="DeleteCard_Click"
                          IsEnabled="{x:Bind CanDelete, Mode=OneWay}" />
                </StackPanel>
                <Button Content="Cancel download" Click="CancelCard_Click"
                        Visibility="{x:Bind IsDownloading, Mode=OneWay}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock FontSize="11" Opacity="0.7" TextWrapping="Wrap"
                 Text="Stars compare the models with each other: accuracy from our test set (lower word error rate is better), speed from CPU throughput, download size in megabytes. Two downloads run at once, and a model you downloaded becomes the active one." />
    </StackPanel>
  </ScrollViewer>
</ContentDialog>
