<Page x:Class="VoiceType.Uno.Presentation.Queue.QueuePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <!-- Placeholder — replaced by agent L at merge. Exists only so navigation compiles. -->
  <Grid RowSpacing="8" Padding="4,4,16,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" MinHeight="56">
      <Button Width="48" Height="48" Padding="0" Background="Transparent" BorderThickness="0"
              Click="Back_Click" AutomationProperties.Name="Back" ToolTipService.ToolTip="Back">
        <SymbolIcon Symbol="Back" />
      </Button>
      <TextBlock Text="Queue" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
    </StackPanel>
    <TextBlock x:Name="Body" Grid.Row="1" Margin="12,0" TextWrapping="Wrap"
               Text="Coming soon." />
  </Grid>
</Page>
