<UserControl x:Class="VoiceType.Uno.Presentation.Controls.ModelStorageBlock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- The ONE "Model storage" block (Settings › History and storage, Models page): the root folder, one live line per
       model kind with its sub-folder, count and size, total + free space, and the one-line explanation. -->
  <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
          BorderThickness="1" CornerRadius="8" Padding="12">
    <StackPanel Spacing="6">
      <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBlock x:Name="ExplanationText" FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
      <TextBlock x:Name="RootCaption" FontSize="11" Opacity="0.7" Margin="0,4,0,0" />
      <TextBlock x:Name="RootText" FontSize="13" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                 AutomationProperties.Name="Model storage folder" />
      <TextBlock x:Name="SpeechLine" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0" />
      <TextBlock x:Name="LanguageLine" FontSize="13" TextWrapping="Wrap" />
      <TextBlock x:Name="SpeakerLine" FontSize="13" TextWrapping="Wrap" />
      <TextBlock x:Name="TotalLine" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0" />
      <TextBlock x:Name="NoteText" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" />
      <Grid x:Name="ButtonRow" ColumnSpacing="8" Margin="0,4,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Button x:Name="OpenFolderButton" MinHeight="44" MinWidth="44" HorizontalAlignment="Stretch"
                Click="OpenFolder_Click" AutomationProperties.Name="Open the model storage folder">
          <TextBlock x:Name="OpenFolderLabel" TextWrapping="Wrap" TextAlignment="Center" />
        </Button>
        <Button x:Name="ChangeFolderButton" Grid.Column="1" MinHeight="44" MinWidth="44" HorizontalAlignment="Stretch"
                Click="ChangeFolder_Click" AutomationProperties.Name="Change the model storage folder">
          <TextBlock Text="Change folder…" TextWrapping="Wrap" TextAlignment="Center" />
        </Button>
      </Grid>
    </StackPanel>
  </Border>
</UserControl>
