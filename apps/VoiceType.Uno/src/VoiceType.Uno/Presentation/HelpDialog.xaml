<ContentDialog x:Class="VoiceType.Uno.Presentation.HelpDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:l="using:VoiceType.Uno.Presentation.Localization"
               Title="{l:Tr Key=Help.Title}"
               CloseButtonText="{l:Tr Key=Help.Close}"
               DefaultButton="Close">
  <ScrollViewer MaxHeight="560" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="12" Padding="4">

      <Border Background="{ThemeResource SystemControlBackgroundAltHighBrush}" Padding="12">
        <StackPanel Spacing="6">
          <TextBlock Text="{l:Tr Key=Help.Start.Title}" FontWeight="SemiBold" />
          <!-- Help.Start.Body: **bold**, *italic*, \n = line break (HelpDialog.xaml.cs) -->
          <TextBlock x:Name="StartBody" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Background="{ThemeResource SystemControlBackgroundAltHighBrush}" Padding="12">
        <StackPanel Spacing="6">
          <TextBlock Text="{l:Tr Key=Help.Hotkey.Title}" FontWeight="SemiBold" />
          <!-- Help.Hotkey.Body: **bold**, *italic*, \n = line break (HelpDialog.xaml.cs) -->
          <TextBlock x:Name="HotkeyBody" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Background="{ThemeResource SystemControlBackgroundAltHighBrush}" Padding="12">
        <StackPanel Spacing="6">
          <TextBlock Text="{l:Tr Key=Help.LinuxInjection.Title}" FontWeight="SemiBold" />
          <!-- Help.LinuxInjection.Body: **bold**, *italic*, \n = line break (HelpDialog.xaml.cs) -->
          <TextBlock x:Name="LinuxInjectionBody" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Background="{ThemeResource SystemControlBackgroundAltHighBrush}" Padding="12">
        <StackPanel Spacing="6">
          <TextBlock Text="{l:Tr Key=Help.Audio.Title}" FontWeight="SemiBold" />
          <!-- Help.Audio.Body: **bold**, *italic*, \n = line break (HelpDialog.xaml.cs) -->
          <TextBlock x:Name="AudioBody" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Background="{ThemeResource SystemControlBackgroundAltHighBrush}" Padding="12">
        <StackPanel Spacing="6">
          <TextBlock Text="{l:Tr Key=Help.Data.Title}" FontWeight="SemiBold" />
          <!-- Help.Data.Body: **bold**, *italic*, \n = line break (HelpDialog.xaml.cs) -->
          <TextBlock x:Name="DataBody" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</ContentDialog>
