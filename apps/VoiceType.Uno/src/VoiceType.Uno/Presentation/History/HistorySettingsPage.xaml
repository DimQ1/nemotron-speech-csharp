<Page x:Class="VoiceType.Uno.Presentation.History.HistorySettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:history="using:VoiceType.Uno.Presentation.History"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
      KeyDown="Page_KeyDown"
      Loaded="Page_Loaded">

  <!-- Settings › History and storage (design §4.6). Every change is written at once
       through SettingsStore (the single writer of settings.json). One column, ≤ 720 px. -->
  <Page.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <history:HistoryStyles />
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="RowGridStyle" TargetType="Grid">
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="ColumnSpacing" Value="12" />
      </Style>
      <Style x:Key="RowDividerStyle" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="12,0" />
        <Setter Property="Background" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
      </Style>
    </ResourceDictionary>
  </Page.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" MinHeight="56" Padding="4" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="48" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button x:Name="BackButton" Style="{StaticResource HistoryIconButtonStyle}" Click="Back_Click"
              AutomationProperties.Name="Back" ToolTipService.ToolTip="Back">
        <Button.KeyboardAccelerators>
          <KeyboardAccelerator Key="Escape" />
        </Button.KeyboardAccelerators>
        <SymbolIcon Symbol="Back" />
      </Button>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="History and storage" FontSize="12" Opacity="0.7" />
      </StackPanel>
    </Grid>

    <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel MaxWidth="720" Margin="16,0,16,24">

        <TextBlock Text="RECORDING HISTORY" Style="{StaticResource HistorySectionHeaderStyle}" />
        <Border Style="{StaticResource HistoryCardStyle}">
          <StackPanel>
            <Grid Style="{StaticResource RowGridStyle}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <SymbolIcon Symbol="Clock" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Save recordings to History" TextWrapping="Wrap" />
                <TextBlock Text="Audio + transcript after each Stop" Style="{StaticResource HistorySecondaryStyle}" />
              </StackPanel>
              <ToggleSwitch x:Name="EnabledSwitch" Grid.Column="2" Style="{StaticResource HistorySwitchStyle}"
                            AutomationProperties.Name="Save recordings to History" Toggled="Setting_Toggled" />
            </Grid>
            <Border Style="{StaticResource RowDividerStyle}" />
            <Grid Style="{StaticResource RowGridStyle}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <SymbolIcon Symbol="Keyboard" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Save Inject text dictations" TextWrapping="Wrap" />
                <TextBlock Text="Short phrases typed into other apps" Style="{StaticResource HistorySecondaryStyle}" />
              </StackPanel>
              <ToggleSwitch x:Name="InjectSwitch" Grid.Column="2" Style="{StaticResource HistorySwitchStyle}"
                            AutomationProperties.Name="Save Inject text dictations" Toggled="Setting_Toggled" />
            </Grid>
            <Border Style="{StaticResource RowDividerStyle}" />
            <Grid Style="{StaticResource RowGridStyle}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <SymbolIcon Symbol="Delete" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Ask before deleting" TextWrapping="Wrap" />
                <TextBlock Text="Off: deletes at once with an 8-second Undo" Style="{StaticResource HistorySecondaryStyle}" />
              </StackPanel>
              <ToggleSwitch x:Name="ConfirmSwitch" Grid.Column="2" Style="{StaticResource HistorySwitchStyle}"
                            AutomationProperties.Name="Ask before deleting" Toggled="Setting_Toggled" />
            </Grid>
          </StackPanel>
        </Border>

        <TextBlock Text="AUDIO STORAGE" Style="{StaticResource HistorySectionHeaderStyle}" />
        <Border Style="{StaticResource HistoryCardStyle}">
          <StackPanel>
            <Grid Style="{StaticResource RowGridStyle}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <SymbolIcon Symbol="Calendar" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Keep audio" TextWrapping="Wrap" />
                <TextBlock Text="Text, versions, translations and chats are kept forever" Style="{StaticResource HistorySecondaryStyle}" />
              </StackPanel>
              <ComboBox x:Name="RetentionCombo" Grid.Column="2" MinHeight="44" MinWidth="112" VerticalAlignment="Center"
                        AutomationProperties.Name="Keep audio" SelectionChanged="Retention_SelectionChanged" />
            </Grid>
            <Border Style="{StaticResource RowDividerStyle}" />
            <Grid Style="{StaticResource RowGridStyle}" RowSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <FontIcon Glyph="&#xEDA2;" FontSize="18" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Storage limit for audio" TextWrapping="Wrap" />
                <TextBlock Text="Oldest audio is removed first" Style="{StaticResource HistorySecondaryStyle}" />
              </StackPanel>
              <ComboBox x:Name="CapCombo" Grid.Column="2" MinHeight="44" MinWidth="112" VerticalAlignment="Center"
                        AutomationProperties.Name="Storage limit for audio" SelectionChanged="Cap_SelectionChanged" />
              <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Spacing="6">
                <ProgressBar x:Name="UsageBar" Minimum="0" Maximum="1" Height="6" />
                <TextBlock x:Name="UsageText" Style="{StaticResource HistorySecondaryStyle}" />
              </StackPanel>
            </Grid>
            <Border Style="{StaticResource RowDividerStyle}" />
            <Grid Style="{StaticResource RowGridStyle}" RowSpacing="4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <FontIcon Glyph="&#xE9D9;" FontSize="18" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Audio quality" TextWrapping="Wrap" />
                <TextBlock Text="For new recordings" Style="{StaticResource HistorySecondaryStyle}" />
              </StackPanel>
              <ComboBox x:Name="QualityCombo" Grid.Column="2" MinHeight="44" MinWidth="112" VerticalAlignment="Center"
                        AutomationProperties.Name="Audio quality" SelectionChanged="Quality_SelectionChanged" />
              <TextBlock x:Name="QualityDetail" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                         Style="{StaticResource HistorySecondaryStyle}" />
            </Grid>
          </StackPanel>
        </Border>

        <TextBlock Text="BACKGROUND JOBS" Style="{StaticResource HistorySectionHeaderStyle}" />
        <Border Style="{StaticResource HistoryCardStyle}">
          <Grid Style="{StaticResource RowGridStyle}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="24" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <SymbolIcon Symbol="Sync" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="Allow jobs during live recording" TextWrapping="Wrap" />
              <TextBlock x:Name="JobsDetail" Text="Re-recognition and translation keep running while you record"
                         Style="{StaticResource HistorySecondaryStyle}" />
            </StackPanel>
            <ToggleSwitch x:Name="JobsSwitch" Grid.Column="2" Style="{StaticResource HistorySwitchStyle}"
                          AutomationProperties.Name="Allow jobs during live recording" Toggled="Setting_Toggled" />
          </Grid>
        </Border>

        <!-- Gemma titles (low-priority autoTitle job after each saved recording) -->
        <Border Style="{StaticResource HistoryCardStyle}" Margin="0,8,0,0">
          <Grid Style="{StaticResource RowGridStyle}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="24" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="✦" FontSize="16" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="Titles by Gemma" TextWrapping="Wrap" />
              <TextBlock x:Name="TitlesDetail" Text="Gemma names each new recording on the device. Your own titles are never replaced"
                         Style="{StaticResource HistorySecondaryStyle}" />
            </StackPanel>
            <ToggleSwitch x:Name="TitlesSwitch" Grid.Column="2" Style="{StaticResource HistorySwitchStyle}"
                          AutomationProperties.Name="Titles by Gemma" Toggled="Setting_Toggled" />
          </Grid>
        </Border>

        <!-- Speakers (Nemotron 3 Diarization): automatic detection after Stop, CPU threads -->
        <StackPanel x:Name="SpeakersGroup" Visibility="Collapsed">
          <TextBlock Text="SPEAKERS" Style="{StaticResource HistorySectionHeaderStyle}" />
          <Border Style="{StaticResource HistoryCardStyle}">
            <StackPanel>
              <Grid Style="{StaticResource RowGridStyle}" RowSpacing="4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="24" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <FontIcon Glyph="&#xE716;" FontSize="18" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="Detect speakers after Stop" TextWrapping="Wrap" />
                  <TextBlock x:Name="AutoSpeakersDetail" Style="{StaticResource HistorySecondaryStyle}" />
                </StackPanel>
                <ComboBox x:Name="AutoSpeakersCombo" Grid.Column="2" MinHeight="44" MinWidth="112" VerticalAlignment="Center"
                          AutomationProperties.Name="Detect speakers after Stop" SelectionChanged="AutoSpeakers_SelectionChanged" />
              </Grid>
              <Border Style="{StaticResource RowDividerStyle}" />
              <Grid Style="{StaticResource RowGridStyle}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="24" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE950;" FontSize="18" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="CPU threads" TextWrapping="Wrap" />
                  <TextBlock x:Name="ThreadsDetail" Style="{StaticResource HistorySecondaryStyle}" />
                </StackPanel>
                <ComboBox x:Name="ThreadsCombo" Grid.Column="2" MinHeight="44" MinWidth="112" VerticalAlignment="Center"
                          AutomationProperties.Name="CPU threads for speaker detection" SelectionChanged="Threads_SelectionChanged" />
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>

        <Border Style="{StaticResource HistoryCardStyle}" Margin="0,24,0,0">
          <Button Style="{StaticResource HistoryRowButtonStyle}" MinHeight="56" Click="DeleteAll_Click"
                  AutomationProperties.Name="Delete all history">
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <SymbolIcon Symbol="Delete" Foreground="{ThemeResource HistoryDangerBrush}" />
              <StackPanel Grid.Column="1">
                <TextBlock Text="Delete all history" Foreground="{ThemeResource HistoryDangerBrush}" FontWeight="SemiBold" />
                <TextBlock x:Name="DeleteAllDetail" Style="{StaticResource HistorySecondaryStyle}" />
              </StackPanel>
            </Grid>
          </Button>
        </Border>

        <TextBlock Margin="4,16,4,0" Style="{StaticResource HistorySecondaryStyle}" FontSize="11"
                   Text="Recordings and transcripts are stored only on this device. Others may need to consent to being recorded." />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
