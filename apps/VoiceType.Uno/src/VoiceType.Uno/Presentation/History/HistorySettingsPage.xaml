<Page x:Class="VoiceType.Uno.Presentation.History.HistorySettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:history="using:VoiceType.Uno.Presentation.History"
      xmlns:controls="using:VoiceType.Uno.Presentation.Controls"
      xmlns:l="using:VoiceType.Uno.Presentation.Localization"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
      KeyDown="Page_KeyDown"
      Loaded="Page_Loaded">

  <!-- Settings › History and storage (design §4.6). Every change is written at once
       through SettingsStore (the single writer of settings.json). One column, ≤ 720 px. -->
  <Page.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <history:HistoryStyles />
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="RowGridStyle" TargetType="Grid">
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="ColumnSpacing" Value="12" />
      </Style>
      <Style x:Key="RowDividerStyle" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="12,0" />
        <Setter Property="Background" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
      </Style>
    </ResourceDictionary>
  </Page.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" MinHeight="56" Padding="4" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="48" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button x:Name="BackButton" Style="{StaticResource HistoryIconButtonStyle}" Click="Back_Click"
              AutomationProperties.Name="{l:Tr Key=History.Common.Back}" ToolTipService.ToolTip="{l:Tr Key=History.Common.Back}">
        <Button.KeyboardAccelerators>
          <KeyboardAccelerator Key="Escape" />
        </Button.KeyboardAccelerators>
        <SymbolIcon Symbol="Back" />
      </Button>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock Text="{l:Tr Key=History.Settings.Title}" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="{l:Tr Key=History.Settings.Subtitle}" FontSize="12" Opacity="0.7" />
      </StackPanel>
    </Grid>

    <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel MaxWidth="720" Margin="16,0,16,24">

        <TextBlock Text="{l:Tr Key=History.Settings.Section.History}" Style="{StaticResource HistorySectionHeaderStyle}" />
        <Border Style="{StaticResource HistoryCardStyle}">
          <StackPanel>
            <Grid Style="{StaticResource RowGridStyle}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <SymbolIcon Symbol="Clock" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{l:Tr Key=History.Settings.Enabled}" TextWrapping="Wrap" />
                <TextBlock Text="{l:Tr Key=History.Settings.EnabledDetail}" Style="{StaticResource HistorySecondaryStyle}" />
              </StackPanel>
              <ToggleSwitch x:Name="EnabledSwitch" Grid.Column="2" Style="{StaticResource HistorySwitchStyle}"
                            AutomationProperties.Name="{l:Tr Key=History.Settings.Enabled}" Toggled="Setting_Toggled" />
            </Grid>
            <Border Style="{StaticResource RowDividerStyle}" />
            <Grid Style="{StaticResource RowGridStyle}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <SymbolIcon Symbol="Keyboard" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{l:Tr Key=History.Settings.Inject}" TextWrapping="Wrap" />
                <TextBlock Text="{l:Tr Key=History.Settings.InjectDetail}" Style="{StaticResource HistorySecondaryStyle}" />
              </StackPanel>
              <ToggleSwitch x:Name="InjectSwitch" Grid.Column="2" Style="{StaticResource HistorySwitchStyle}"
                            AutomationProperties.Name="{l:Tr Key=History.Settings.Inject}" Toggled="Setting_Toggled" />
            </Grid>
            <Border Style="{StaticResource RowDividerStyle}" />
            <Grid Style="{StaticResource RowGridStyle}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <SymbolIcon Symbol="Delete" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{l:Tr Key=History.Settings.Confirm}" TextWrapping="Wrap" />
                <TextBlock Text="{l:Tr Key=History.Settings.ConfirmDetail}" Style="{StaticResource HistorySecondaryStyle}" />
              </StackPanel>
              <ToggleSwitch x:Name="ConfirmSwitch" Grid.Column="2" Style="{StaticResource HistorySwitchStyle}"
                            AutomationProperties.Name="{l:Tr Key=History.Settings.Confirm}" Toggled="Setting_Toggled" />
            </Grid>
          </StackPanel>
        </Border>

        <TextBlock Text="{l:Tr Key=History.Settings.Section.Audio}" Style="{StaticResource HistorySectionHeaderStyle}" />
        <Border Style="{StaticResource HistoryCardStyle}">
          <StackPanel>
            <Grid Style="{StaticResource RowGridStyle}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <SymbolIcon Symbol="Calendar" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{l:Tr Key=History.Settings.KeepAudio}" TextWrapping="Wrap" />
                <TextBlock Text="{l:Tr Key=History.Settings.KeepAudioDetail}" Style="{StaticResource HistorySecondaryStyle}" />
              </StackPanel>
              <ComboBox x:Name="RetentionCombo" Grid.Column="2" MinHeight="44" MinWidth="112" VerticalAlignment="Center"
                        AutomationProperties.Name="{l:Tr Key=History.Settings.KeepAudio}" SelectionChanged="Retention_SelectionChanged" />
            </Grid>
            <Border Style="{StaticResource RowDividerStyle}" />
            <Grid Style="{StaticResource RowGridStyle}" RowSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <FontIcon Glyph="&#xEDA2;" FontSize="18" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{l:Tr Key=History.Settings.Cap}" TextWrapping="Wrap" />
                <TextBlock Text="{l:Tr Key=History.Settings.CapDetail}" Style="{StaticResource HistorySecondaryStyle}" />
              </StackPanel>
              <ComboBox x:Name="CapCombo" Grid.Column="2" MinHeight="44" MinWidth="112" VerticalAlignment="Center"
                        AutomationProperties.Name="{l:Tr Key=History.Settings.Cap}" SelectionChanged="Cap_SelectionChanged" />
              <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Spacing="6">
                <ProgressBar x:Name="UsageBar" Minimum="0" Maximum="1" Height="6" />
                <TextBlock x:Name="UsageText" Style="{StaticResource HistorySecondaryStyle}" />
              </StackPanel>
            </Grid>
            <Border Style="{StaticResource RowDividerStyle}" />
            <Grid Style="{StaticResource RowGridStyle}" RowSpacing="4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <FontIcon Glyph="&#xE9D9;" FontSize="18" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{l:Tr Key=History.Settings.Quality}" TextWrapping="Wrap" />
                <TextBlock Text="{l:Tr Key=History.Settings.QualityDetail}" Style="{StaticResource HistorySecondaryStyle}" />
              </StackPanel>
              <ComboBox x:Name="QualityCombo" Grid.Column="2" MinHeight="44" MinWidth="112" VerticalAlignment="Center"
                        AutomationProperties.Name="{l:Tr Key=History.Settings.Quality}" SelectionChanged="Quality_SelectionChanged" />
              <TextBlock x:Name="QualityDetail" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                         Style="{StaticResource HistorySecondaryStyle}" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- The one place that says where ALL models (speech, Gemma, speaker detection) are stored -->
        <TextBlock Text="{l:Tr Key=History.Settings.Section.Models}" Style="{StaticResource HistorySectionHeaderStyle}" />
        <controls:ModelStorageBlock x:Name="ModelStorage" />

        <TextBlock Text="{l:Tr Key=History.Settings.Section.Jobs}" Style="{StaticResource HistorySectionHeaderStyle}" />
        <Border Style="{StaticResource HistoryCardStyle}">
          <Grid Style="{StaticResource RowGridStyle}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="24" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <SymbolIcon Symbol="Sync" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="{l:Tr Key=History.Settings.Jobs}" TextWrapping="Wrap" />
              <TextBlock x:Name="JobsDetail" Text="{l:Tr Key=History.Settings.JobsDetail}"
                         Style="{StaticResource HistorySecondaryStyle}" />
            </StackPanel>
            <ToggleSwitch x:Name="JobsSwitch" Grid.Column="2" Style="{StaticResource HistorySwitchStyle}"
                          AutomationProperties.Name="{l:Tr Key=History.Settings.Jobs}" Toggled="Setting_Toggled" />
          </Grid>
        </Border>

        <!-- Gemma titles (low-priority autoTitle job after each saved recording) -->
        <Border Style="{StaticResource HistoryCardStyle}" Margin="0,8,0,0">
          <Grid Style="{StaticResource RowGridStyle}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="24" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="✦" FontSize="16" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="{l:Tr Key=History.Settings.Titles}" TextWrapping="Wrap" />
              <TextBlock x:Name="TitlesDetail" Text="{l:Tr Key=History.Settings.TitlesDetail}"
                         Style="{StaticResource HistorySecondaryStyle}" />
            </StackPanel>
            <ToggleSwitch x:Name="TitlesSwitch" Grid.Column="2" Style="{StaticResource HistorySwitchStyle}"
                          AutomationProperties.Name="{l:Tr Key=History.Settings.Titles}" Toggled="Setting_Toggled" />
          </Grid>
        </Border>

        <!-- Speakers (Nemotron 3 Diarization): automatic detection after Stop, CPU threads -->
        <StackPanel x:Name="SpeakersGroup" Visibility="Collapsed">
          <TextBlock Text="{l:Tr Key=History.Settings.Section.Speakers}" Style="{StaticResource HistorySectionHeaderStyle}" />
          <Border Style="{StaticResource HistoryCardStyle}">
            <StackPanel>
              <Grid Style="{StaticResource RowGridStyle}" RowSpacing="4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="24" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <FontIcon Glyph="&#xE716;" FontSize="18" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{l:Tr Key=History.Settings.AutoSpeakers}" TextWrapping="Wrap" />
                  <TextBlock x:Name="AutoSpeakersDetail" Style="{StaticResource HistorySecondaryStyle}" />
                </StackPanel>
                <ComboBox x:Name="AutoSpeakersCombo" Grid.Column="2" MinHeight="44" MinWidth="112" VerticalAlignment="Center"
                          AutomationProperties.Name="{l:Tr Key=History.Settings.AutoSpeakers}" SelectionChanged="AutoSpeakers_SelectionChanged" />
              </Grid>
              <Border Style="{StaticResource RowDividerStyle}" />
              <Grid Style="{StaticResource RowGridStyle}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="24" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE950;" FontSize="18" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{l:Tr Key=History.Settings.Threads}" TextWrapping="Wrap" />
                  <TextBlock x:Name="ThreadsDetail" Style="{StaticResource HistorySecondaryStyle}" />
                </StackPanel>
                <ComboBox x:Name="ThreadsCombo" Grid.Column="2" MinHeight="44" MinWidth="112" VerticalAlignment="Center"
                          AutomationProperties.Name="{l:Tr Key=History.Settings.ThreadsName}" SelectionChanged="Threads_SelectionChanged" />
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>

        <Border Style="{StaticResource HistoryCardStyle}" Margin="0,24,0,0">
          <Button Style="{StaticResource HistoryRowButtonStyle}" MinHeight="56" Click="DeleteAll_Click"
                  AutomationProperties.Name="{l:Tr Key=History.Settings.DeleteAll}">
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <SymbolIcon Symbol="Delete" Foreground="{ThemeResource HistoryDangerBrush}" />
              <StackPanel Grid.Column="1">
                <TextBlock Text="{l:Tr Key=History.Settings.DeleteAll}" Foreground="{ThemeResource HistoryDangerBrush}" FontWeight="SemiBold" />
                <TextBlock x:Name="DeleteAllDetail" Style="{StaticResource HistorySecondaryStyle}" />
              </StackPanel>
            </Grid>
          </Button>
        </Border>

        <TextBlock Margin="4,16,4,0" Style="{StaticResource HistorySecondaryStyle}" FontSize="11"
                   Text="{l:Tr Key=History.Settings.Privacy}" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
