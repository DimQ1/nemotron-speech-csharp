<Page x:Class="VoiceType.Uno.Presentation.History.HistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:history="using:VoiceType.Uno.Presentation.History"
      xmlns:controls="using:VoiceType.Uno.Presentation.Controls"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
      KeyDown="Page_KeyDown"
      Loaded="Page_Loaded"
      Unloaded="Page_Unloaded"
      SizeChanged="Page_SizeChanged">

  <!-- History (design §4.2): search + filter, date groups, rows with ⋯, long-press
       multi-select, storage card. From 840 px: master-detail, list 360 px on the left and
       the recording on the right (a nested Frame hosting RecordingPage). -->
  <Page.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <history:HistoryStyles />
      </ResourceDictionary.MergedDictionaries>

      <DataTemplate x:Key="BadgeTemplate" x:DataType="history:HistoryBadgeViewModel">
        <Grid AutomationProperties.Name="{x:Bind AutomationName}">
          <Border Style="{StaticResource HistoryChipStyle}" Visibility="{x:Bind IsNeutral}">
            <TextBlock Text="{x:Bind Text}" Style="{StaticResource HistoryChipTextStyle}" />
          </Border>
          <Border Style="{StaticResource HistoryChipStyle}" Visibility="{x:Bind IsAccent}"
                  Background="{ThemeResource HistoryHintBrush}" BorderBrush="Transparent">
            <TextBlock Text="{x:Bind Text}" Style="{StaticResource HistoryChipTextStyle}" FontWeight="SemiBold" />
          </Border>
          <Border Style="{StaticResource HistoryChipStyle}" Visibility="{x:Bind IsWarning}"
                  Background="{ThemeResource HistoryWarningChipBrush}" BorderBrush="{ThemeResource HistoryWarningStrokeBrush}">
            <TextBlock Text="{x:Bind Text}" Style="{StaticResource HistoryChipTextStyle}" />
          </Border>
        </Grid>
      </DataTemplate>

      <DataTemplate x:Key="RowTemplate" x:DataType="history:HistoryRowViewModel">
        <Grid MinHeight="76">
          <Border Style="{StaticResource HistoryCardStyle}" />
          <Border CornerRadius="8" BorderThickness="1.5"
                  Background="{ThemeResource HistorySelectedBrush}"
                  BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                  Visibility="{x:Bind IsHighlighted, Mode=OneWay}" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource HistoryRowButtonStyle}" Padding="12,10,4,10"
                    Click="Row_Click" RightTapped="Row_RightTapped" Holding="Row_Holding"
                    AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}">
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- Duration pill, or the selection check in selection mode -->
                <Border MinWidth="52" Padding="6,2" CornerRadius="10" VerticalAlignment="Center"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                        Visibility="{x:Bind ShowDuration, Mode=OneWay}">
                  <TextBlock Text="{x:Bind DurationText}" FontSize="11" HorizontalAlignment="Center" />
                </Border>
                <Grid Width="24" Height="24" VerticalAlignment="Center" Margin="8,0"
                      Visibility="{x:Bind IsSelectionMode, Mode=OneWay}">
                  <Border CornerRadius="4" BorderThickness="1.5" BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
                  <Border CornerRadius="4" Background="{ThemeResource AccentFillColorDefaultBrush}"
                          Visibility="{x:Bind ShowCheckmark, Mode=OneWay}">
                    <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                  </Border>
                </Grid>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="{x:Bind Title}" Style="{StaticResource HistoryTitleStyle}"
                             MaxLines="2" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{x:Bind MetaText}" Style="{StaticResource HistorySecondaryStyle}"
                             TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{x:Bind Snippet}" Style="{StaticResource HistorySecondaryStyle}" FontStyle="Italic"
                             MaxLines="2" TextTrimming="CharacterEllipsis" Visibility="{x:Bind HasSnippet}" />
                  <ItemsControl ItemsSource="{x:Bind Badges}" ItemTemplate="{StaticResource BadgeTemplate}"
                                Margin="0,4,0,0" Visibility="{x:Bind HasBadges}" IsTabStop="False">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <controls:ChipWrapPanel Spacing="4" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                  </ItemsControl>
                </StackPanel>
              </Grid>
            </Button>
            <Button Grid.Column="1" Width="44" Height="44" Margin="0,0,4,0" Padding="0"
                    Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                    Click="RowMore_Click" Visibility="{x:Bind ShowMore, Mode=OneWay}"
                    AutomationProperties.Name="More actions" ToolTipService.ToolTip="More actions">
              <SymbolIcon Symbol="More" />
            </Button>
          </Grid>
        </Grid>
      </DataTemplate>

      <DataTemplate x:Key="GroupTemplate" x:DataType="history:HistoryGroupViewModel">
        <StackPanel>
          <TextBlock Text="{x:Bind Label}" Style="{StaticResource HistorySectionHeaderStyle}"
                     Visibility="{x:Bind HasLabel}" />
          <ItemsControl ItemsSource="{x:Bind Rows}" ItemTemplate="{StaticResource RowTemplate}" IsTabStop="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </StackPanel>
      </DataTemplate>
    </ResourceDictionary>
  </Page.Resources>

  <Grid x:Name="LayoutRoot">
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="ListColumn" Width="*" />
      <ColumnDefinition x:Name="DetailColumn" Width="0" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ── List ─────────────────────────────────────────────────────── -->
    <Grid x:Name="ListPane" Grid.Row="0" Grid.Column="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />  <!-- 0 top bar -->
        <RowDefinition Height="Auto" />  <!-- 1 search -->
        <RowDefinition Height="Auto" />  <!-- 2 filter chips -->
        <RowDefinition Height="*" />     <!-- 3 list -->
      </Grid.RowDefinitions>

      <!-- Top bar: back, title + subtitle -->
      <Grid Grid.Row="0" MinHeight="56" Padding="4" ColumnSpacing="8"
            Visibility="{x:Bind ViewModel.IsNormalMode, Mode=OneWay}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="48" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="48" />
        </Grid.ColumnDefinitions>
        <Button x:Name="BackButton" Style="{StaticResource HistoryIconButtonStyle}" Click="Back_Click"
                AutomationProperties.Name="Back" ToolTipService.ToolTip="Back">
          <Button.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" />
          </Button.KeyboardAccelerators>
          <SymbolIcon Symbol="Back" />
        </Button>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="History" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" FontSize="12" Opacity="0.7"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Button Grid.Column="2" Style="{StaticResource HistoryIconButtonStyle}" Click="Settings_Click"
                AutomationProperties.Name="History settings" ToolTipService.ToolTip="History and storage settings">
          <SymbolIcon Symbol="Setting" />
        </Button>
      </Grid>

      <!-- Selection bar: × · N selected · Reprocess · Select all · Delete -->
      <Grid Grid.Row="0" MinHeight="56" Padding="4" ColumnSpacing="0"
            Visibility="{x:Bind ViewModel.IsSelectionMode, Mode=OneWay}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="48" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="48" />
          <ColumnDefinition Width="48" />
          <ColumnDefinition Width="48" />
        </Grid.ColumnDefinitions>
        <Button Style="{StaticResource HistoryIconButtonStyle}" Click="CancelSelection_Click"
                AutomationProperties.Name="Cancel selection" ToolTipService.ToolTip="Cancel selection">
          <SymbolIcon Symbol="Cancel" />
        </Button>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
          <TextBlock Text="{x:Bind ViewModel.SelectionTitle, Mode=OneWay}" FontSize="18" FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{x:Bind ViewModel.SelectionSubtitle, Mode=OneWay}" FontSize="12" Opacity="0.7"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Button Grid.Column="2" Style="{StaticResource HistoryIconButtonStyle}" Click="ReprocessSelected_Click"
                IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                AutomationProperties.Name="Reprocess selected" ToolTipService.ToolTip="Re-recognize the selected recordings">
          <SymbolIcon Symbol="Refresh" />
        </Button>
        <Button Grid.Column="3" Style="{StaticResource HistoryIconButtonStyle}" Click="SelectAll_Click"
                AutomationProperties.Name="Select all" ToolTipService.ToolTip="Select all">
          <SymbolIcon Symbol="SelectAll" />
        </Button>
        <Button Grid.Column="4" Style="{StaticResource HistoryIconButtonStyle}" Click="DeleteSelected_Click"
                IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                AutomationProperties.Name="Delete selected" ToolTipService.ToolTip="Delete the selected recordings">
          <SymbolIcon Symbol="Delete" />
        </Button>
      </Grid>

      <!-- Search + filter -->
      <Grid Grid.Row="1" Margin="16,0,8,8" ColumnSpacing="4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="48" />
        </Grid.ColumnDefinitions>
        <TextBox x:Name="SearchBox" MinHeight="44" VerticalContentAlignment="Center"
                 PlaceholderText="Search transcripts, translations, chats"
                 AutomationProperties.Name="Search recordings"
                 TextChanged="SearchBox_TextChanged" />
        <Button Grid.Column="1" Style="{StaticResource HistoryIconButtonStyle}" Click="Filter_Click"
                AutomationProperties.Name="Filter" ToolTipService.ToolTip="Filter and sort">
          <Grid Width="24" Height="24">
            <FontIcon Glyph="&#xE71C;" FontSize="18" />
            <Ellipse Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top"
                     Fill="{ThemeResource AccentFillColorDefaultBrush}"
                     Visibility="{x:Bind ViewModel.IsFilterActive, Mode=OneWay}" />
          </Grid>
        </Button>
      </Grid>

      <!-- Active filters as removable chips -->
      <ItemsControl Grid.Row="2" Margin="16,0,16,8" ItemsSource="{x:Bind ViewModel.FilterChips}"
                    Visibility="{x:Bind ViewModel.HasChips, Mode=OneWay}" IsTabStop="False">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <controls:ChipWrapPanel Spacing="8" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="history:HistoryChipViewModel">
            <Button MinHeight="44" CornerRadius="22" Padding="14,0,10,0" Click="Chip_Click"
                    Background="{ThemeResource HistoryHintBrush}" BorderThickness="0"
                    AutomationProperties.Name="{x:Bind AutomationName}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{x:Bind Label}" FontSize="13" VerticalAlignment="Center" />
                <SymbolIcon Symbol="Cancel" RenderTransformOrigin="0.5,0.5">
                  <SymbolIcon.RenderTransform>
                    <ScaleTransform ScaleX="0.7" ScaleY="0.7" />
                  </SymbolIcon.RenderTransform>
                </SymbolIcon>
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <ScrollViewer x:Name="ListScroll" Grid.Row="3"
                    HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8,0,8,16" Spacing="0">
          <ItemsControl ItemsSource="{x:Bind ViewModel.Groups}" ItemTemplate="{StaticResource GroupTemplate}"
                        IsTabStop="False" />

          <!-- Empty state -->
          <StackPanel Margin="8,32,8,16" Spacing="8" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
            <FontIcon Glyph="&#xE81C;" FontSize="40" Opacity="0.5" HorizontalAlignment="Left" />
            <TextBlock Text="{x:Bind ViewModel.EmptyTitle, Mode=OneWay}" Style="{StaticResource HistoryTitleStyle}" FontSize="18" />
            <TextBlock Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}" Style="{StaticResource HistorySecondaryStyle}" FontSize="13" />
          </StackPanel>

          <!-- Storage card -->
          <Border Style="{StaticResource HistoryCardStyle}" Margin="0,16,0,0" Padding="12,8,8,8"
                  Visibility="{x:Bind ViewModel.ShowStorage, Mode=OneWay}">
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.StorageTitle, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{x:Bind ViewModel.StorageDetail, Mode=OneWay}" Style="{StaticResource HistorySecondaryStyle}" />
              </StackPanel>
              <Button Grid.Column="1" Content="Manage" Style="{StaticResource HistoryActionButtonStyle}"
                      Click="Settings_Click" AutomationProperties.Name="Manage storage" />
            </Grid>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- ── Detail (≥ 840 px) ───────────────────────────────────────── -->
    <Grid x:Name="DetailPane" Grid.Row="0" Grid.Column="1" Visibility="Collapsed"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
      <StackPanel x:Name="DetailPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center"
                  Spacing="8" MaxWidth="360" Padding="16">
        <FontIcon Glyph="&#xE8BD;" FontSize="40" Opacity="0.5" />
        <TextBlock Text="Select a recording" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <TextBlock Text="Its transcript, versions and chats open here." Style="{StaticResource HistorySecondaryStyle}"
                   TextAlignment="Center" />
      </StackPanel>
      <Frame x:Name="DetailFrame" Visibility="Collapsed" />
    </Grid>

    <history:UndoSnackbar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" />
  </Grid>
</Page>
