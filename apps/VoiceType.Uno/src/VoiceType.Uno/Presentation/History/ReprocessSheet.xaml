<ContentDialog x:Class="VoiceType.Uno.Presentation.History.ReprocessSheet"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:l="using:VoiceType.Uno.Presentation.Localization"
               PrimaryButtonText="{l:Tr Key=Recording.Reprocess.Start}"
               CloseButtonText="{l:Tr Key=Recording.Edit.Cancel}"
               DefaultButton="Primary"
               PrimaryButtonClick="Start_Click">

  <ContentDialog.Resources>
    <Style x:Key="SheetSectionStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="CharacterSpacing" Value="40" />
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="Margin" Value="0,12,0,4" />
    </Style>
    <Style x:Key="SheetHintStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </ContentDialog.Resources>

  <ContentDialog.Title>
    <StackPanel Spacing="2">
      <TextBlock x:Name="TitleText" Text="{l:Tr Key=Recording.Reprocess.Title}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBlock x:Name="SubtitleText" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
    </StackPanel>
  </ContentDialog.Title>

  <ScrollViewer HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto" MaxHeight="560">
    <StackPanel MinWidth="280" MaxWidth="520" Padding="0,0,8,0">
      <!-- Chain steps (design §11.1): shown only when the chain adapter is registered (IReprocessChainEnqueuer) -->
      <StackPanel x:Name="ChainPanel" Visibility="Collapsed">
        <TextBlock Text="{l:Tr Key=Recording.Reprocess.Steps}" Style="{StaticResource SheetSectionStyle}" Margin="0,0,0,4" />
        <Grid ColumnSpacing="12" MinHeight="44">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{l:Tr Key=Recording.Reprocess.Step1}" FontSize="14" />
            <TextBlock Text="{l:Tr Key=Recording.Reprocess.Step1Hint}" Style="{StaticResource SheetHintStyle}" />
          </StackPanel>
          <ToggleSwitch x:Name="SpeechStepSwitch" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" MinHeight="48" IsOn="True"
                        Toggled="Steps_Toggled" AutomationProperties.Name="{l:Tr Key=Recording.Reprocess.Step1Name}" />
        </Grid>
        <Grid ColumnSpacing="12" MinHeight="44" Margin="0,4,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{l:Tr Key=Recording.Reprocess.Step2}" FontSize="14" />
            <TextBlock x:Name="SpeakersStepHint" Text="{l:Tr Key=Recording.Reprocess.Step2Hint}" Style="{StaticResource SheetHintStyle}" />
          </StackPanel>
          <ToggleSwitch x:Name="SpeakersStepSwitch" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" MinHeight="48"
                        Toggled="Steps_Toggled" AutomationProperties.Name="{l:Tr Key=Recording.Reprocess.Step2Name}" />
        </Grid>
        <ComboBox x:Name="SpeakersPresetBox" HorizontalAlignment="Stretch" MinHeight="44" Margin="0,4,0,0" SelectedIndex="0"
                  AutomationProperties.Name="{l:Tr Key=Recording.Reprocess.SpeakerMode}">
          <ComboBoxItem Content="{l:Tr Key=Recording.Reprocess.SpeakerModeOffline}" />
          <ComboBoxItem Content="{l:Tr Key=Recording.Reprocess.SpeakerModeFast}" />
        </ComboBox>
        <Grid ColumnSpacing="12" MinHeight="44" Margin="0,4,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{l:Tr Key=Recording.Reprocess.Step3}" FontSize="14" />
            <TextBlock Text="{l:Tr Key=Recording.Reprocess.Step3Hint}" Style="{StaticResource SheetHintStyle}" />
          </StackPanel>
          <ToggleSwitch x:Name="AnalysisStepSwitch" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" MinHeight="48"
                        Toggled="Steps_Toggled" AutomationProperties.Name="{l:Tr Key=Recording.Reprocess.Step3Name}" />
        </Grid>
      </StackPanel>

      <StackPanel x:Name="SpeechSection">
      <TextBlock Text="{l:Tr Key=Recording.Reprocess.ModelSection}" Style="{StaticResource SheetSectionStyle}" Margin="0,0,0,4" />
      <StackPanel x:Name="ModelList" Spacing="2" />
      <TextBlock x:Name="NoModelsText" Visibility="Collapsed" Style="{StaticResource SheetHintStyle}"
                 Text="{l:Tr Key=Recording.Reprocess.NoModels}" />

      <TextBlock Text="{l:Tr Key=Recording.Reprocess.LanguageSection}" Style="{StaticResource SheetSectionStyle}" />
      <ComboBox x:Name="LanguageBox" HorizontalAlignment="Stretch" MinHeight="44"
                AutomationProperties.Name="{l:Tr Key=Recording.Reprocess.LanguageName}" />
      <TextBlock x:Name="LanguageHint" Visibility="Collapsed" Style="{StaticResource SheetHintStyle}"
                 Text="{l:Tr Key=Recording.Reprocess.LanguageHint}" />

      <TextBlock Text="{l:Tr Key=Recording.Reprocess.OptionsSection}" Style="{StaticResource SheetSectionStyle}" />
      <Grid ColumnSpacing="12" MinHeight="44" Margin="0,4,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{l:Tr Key=Recording.Reprocess.Vad}" FontSize="14" />
          <TextBlock Text="{l:Tr Key=Recording.Reprocess.VadHint}" Style="{StaticResource SheetHintStyle}" />
        </StackPanel>
        <ToggleSwitch x:Name="VadSwitch" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" MinHeight="48"
                      AutomationProperties.Name="{l:Tr Key=Recording.Reprocess.Vad}" />
      </Grid>
      <Grid ColumnSpacing="12" MinHeight="44" Margin="0,4,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="MakeCurrentLabel" Text="{l:Tr Key=Recording.Reprocess.MakeCurrent}" FontSize="14" />
          <TextBlock Text="{l:Tr Key=Recording.Reprocess.MakeCurrentHint}" Style="{StaticResource SheetHintStyle}" />
        </StackPanel>
        <ToggleSwitch x:Name="MakeCurrentSwitch" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" MinHeight="48"
                      AutomationProperties.Name="{l:Tr Key=Recording.Reprocess.MakeCurrentName}" />
      </Grid>

      </StackPanel>

      <TextBlock Text="{l:Tr Key=Recording.Reprocess.WhenSection}" Style="{StaticResource SheetSectionStyle}" />
      <RadioButton x:Name="WhenNow" GroupName="When" IsChecked="True" MinHeight="44" Checked="When_Changed">
        <StackPanel>
          <TextBlock x:Name="WhenNowText" Text="{l:Tr Key=Recording.Reprocess.Now}" />
          <TextBlock Text="{l:Tr Key=Recording.Reprocess.NowHint}" Style="{StaticResource SheetHintStyle}" />
        </StackPanel>
      </RadioButton>
      <RadioButton x:Name="WhenIdle" GroupName="When" MinHeight="44" Checked="When_Changed">
        <StackPanel>
          <TextBlock Text="{l:Tr Key=Recording.Reprocess.Idle}" />
          <TextBlock Text="{l:Tr Key=Recording.Reprocess.IdleHint}" Style="{StaticResource SheetHintStyle}" />
        </StackPanel>
      </RadioButton>
      <RadioButton x:Name="WhenCharging" GroupName="When" MinHeight="44" Checked="When_Changed">
        <StackPanel>
          <TextBlock Text="{l:Tr Key=Recording.Reprocess.Charging}" />
          <TextBlock x:Name="WhenChargingHint" Text="{l:Tr Key=Recording.Reprocess.ChargingHint}" Style="{StaticResource SheetHintStyle}" />
        </StackPanel>
      </RadioButton>
      <RadioButton x:Name="WhenWindow" GroupName="When" MinHeight="44" Checked="When_Changed">
        <StackPanel>
          <TextBlock Text="{l:Tr Key=Recording.Reprocess.Window}" />
          <TextBlock x:Name="WindowHint" Text="{l:Tr Key=Recording.Reprocess.WindowHint}" Style="{StaticResource SheetHintStyle}" />
        </StackPanel>
      </RadioButton>
      <StackPanel x:Name="WindowPanel" Visibility="Collapsed" Spacing="8" Margin="28,4,0,0">
        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <ComboBox x:Name="WindowFrom" HorizontalAlignment="Stretch" MinHeight="44" AutomationProperties.Name="{l:Tr Key=Recording.Reprocess.WindowStart}" SelectionChanged="Window_Changed" />
          <TextBlock Grid.Column="1" Text="–" VerticalAlignment="Center" />
          <ComboBox x:Name="WindowTo" Grid.Column="2" HorizontalAlignment="Stretch" MinHeight="44" AutomationProperties.Name="{l:Tr Key=Recording.Reprocess.WindowEnd}" SelectionChanged="Window_Changed" />
        </Grid>
        <CheckBox x:Name="WindowCharging" Content="{l:Tr Key=Recording.Reprocess.WindowCharging}" MinHeight="44" />
      </StackPanel>

      <TextBlock x:Name="EstimateText" Style="{StaticResource SheetHintStyle}" Margin="0,16,0,0" FontSize="13" Opacity="0.85" />
      <TextBlock x:Name="ErrorText" Visibility="Collapsed" TextWrapping="Wrap" FontSize="13" Margin="0,8,0,0"
                 Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
    </StackPanel>
  </ScrollViewer>
</ContentDialog>
