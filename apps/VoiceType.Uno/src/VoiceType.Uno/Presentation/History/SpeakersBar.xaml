<UserControl x:Class="VoiceType.Uno.Presentation.History.SpeakersBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:history="using:VoiceType.Uno.Presentation.History"
             xmlns:controls="using:VoiceType.Uno.Presentation.Controls">

  <!-- Speaker controls above the transcript (design §10.8). Three layouts, one of them visible:
       < 600 px  one-line summary that opens the Speakers sheet
       600-839   inline picker (filter) + sheet button
       >= 840    one filter chip per speaker.
       Under them: the active filter line, and the "Detect speakers" card while there is no layer. -->
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <history:HistoryStyles />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <StackPanel Spacing="6">

    <!-- < 600 px -->
    <Grid x:Name="SummaryRow" ColumnSpacing="4" Visibility="Collapsed">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button x:Name="SummaryButton" MinHeight="44" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
              Padding="12,0" Click="OpenSheet_Click" AutomationProperties.Name="Speakers">
        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <FontIcon Glyph="&#xE716;" FontSize="14" VerticalAlignment="Center" />
          <TextBlock x:Name="SummaryText" Grid.Column="1" FontSize="13" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
          <FontIcon Grid.Column="2" Glyph="&#xE70D;" FontSize="10" VerticalAlignment="Center" />
        </Grid>
      </Button>
      <ToggleButton x:Name="SummaryColorToggle" Grid.Column="1" Width="44" Height="44" Padding="0"
                    Click="ColorToggle_Click" AutomationProperties.Name="Colour words by speaker"
                    ToolTipService.ToolTip="Colour words by speaker">
        <FontIcon Glyph="&#xE790;" FontSize="16" />
      </ToggleButton>
    </Grid>

    <!-- 600-839 px -->
    <Grid x:Name="PickerRow" ColumnSpacing="4" Visibility="Collapsed">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button x:Name="PickerButton" MinHeight="44" Padding="12,0" Click="Picker_Click"
              AutomationProperties.Name="Filter by speaker">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <FontIcon Glyph="&#xE716;" FontSize="14" VerticalAlignment="Center" />
          <TextBlock x:Name="PickerText" FontSize="13" VerticalAlignment="Center" />
          <FontIcon Glyph="&#xE70D;" FontSize="10" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <ToggleButton x:Name="PickerColorToggle" Grid.Column="2" Width="44" Height="44" Padding="0"
                    Click="ColorToggle_Click" AutomationProperties.Name="Colour words by speaker"
                    ToolTipService.ToolTip="Colour words by speaker">
        <FontIcon Glyph="&#xE790;" FontSize="16" />
      </ToggleButton>
      <Button Grid.Column="3" Width="44" Height="44" Padding="0" Click="OpenSheet_Click"
              AutomationProperties.Name="Manage speakers" ToolTipService.ToolTip="Rename, merge">
        <SymbolIcon Symbol="Edit" />
      </Button>
    </Grid>

    <!-- >= 840 px -->
    <controls:ChipWrapPanel x:Name="ChipsRow" Spacing="8" Visibility="Collapsed">
      <ToggleButton x:Name="ChipsColorToggle" Width="44" Height="44" Padding="0"
                    Click="ColorToggle_Click" AutomationProperties.Name="Colour words by speaker"
                    ToolTipService.ToolTip="Colour words by speaker">
        <FontIcon Glyph="&#xE790;" FontSize="16" />
      </ToggleButton>
      <Button x:Name="ManageButton" MinHeight="44" Padding="14,0" Content="Rename, merge" Click="OpenSheet_Click"
              AutomationProperties.Name="Manage speakers" />
    </controls:ChipWrapPanel>

    <!-- Active filter -->
    <Grid x:Name="FilterRow" ColumnSpacing="4" Visibility="Collapsed">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="4,0,0,0">
        <controls:SpeakerSwatch x:Name="FilterSwatch" Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center" />
        <TextBlock x:Name="FilterText" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
      </StackPanel>
      <Button Grid.Column="1" Width="44" Height="44" Padding="0" Background="Transparent" BorderThickness="0"
              Click="ClearFilter_Click" AutomationProperties.Name="Show all speakers" ToolTipService.ToolTip="Show all speakers">
        <SymbolIcon Symbol="Cancel" />
      </Button>
    </Grid>

    <!-- No layer yet -->
    <Border x:Name="DetectCard" Style="{StaticResource HistoryHintStyle}" Visibility="Collapsed">
      <StackPanel Spacing="6">
        <TextBlock x:Name="DetectTitle" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="DetectDetail" FontSize="12" TextWrapping="Wrap" Opacity="0.85" />
        <ProgressBar x:Name="DetectProgress" Visibility="Collapsed" Minimum="0" Maximum="1" />
        <Button x:Name="DetectButton" Style="{StaticResource HistoryActionButtonStyle}" HorizontalAlignment="Left"
                Click="Detect_Click" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
