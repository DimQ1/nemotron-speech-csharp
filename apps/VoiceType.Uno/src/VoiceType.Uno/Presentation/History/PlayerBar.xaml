<UserControl x:Class="VoiceType.Uno.Presentation.History.PlayerBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Unloaded="OnUnloaded">

  <UserControl.Resources>
    <Style x:Key="PlayerRoundButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Width" Value="48" />
      <Setter Property="Height" Value="48" />
      <Setter Property="CornerRadius" Value="24" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </UserControl.Resources>

  <Grid RowSpacing="4" Padding="12,4,12,8">
    <Grid.RowDefinitions>
      <RowDefinition Height="44" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Seek row: 44 px touch target, ticks at segment starts under the thumb. -->
    <Grid Grid.Row="0">
      <Canvas x:Name="TickCanvas" Height="10" VerticalAlignment="Center" Margin="10,0"
              IsHitTestVisible="False" SizeChanged="OnTickCanvasSizeChanged" />
      <Slider x:Name="SeekSlider"
              VerticalAlignment="Center"
              Minimum="0" Maximum="1" StepFrequency="0.1" SmallChange="1" LargeChange="10"
              IsThumbToolTipEnabled="False"
              IsEnabled="False"
              AutomationProperties.Name="Seek"
              ValueChanged="OnSeekSliderValueChanged" />
    </Grid>

    <!-- Controls. Play sits in the middle column of "*,Auto,*" with ±10 on each side of it
         (same width), so it is centred exactly like Record on the main screen. -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <TextBlock x:Name="TimeText" Grid.Column="0"
                 VerticalAlignment="Center" HorizontalAlignment="Left"
                 FontSize="12" TextTrimming="CharacterEllipsis"
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                 Text="0:00 / 0:00" />

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
        <Button x:Name="BackButton" Style="{StaticResource PlayerRoundButtonStyle}"
                IsEnabled="False" Click="OnBackClick"
                AutomationProperties.Name="Back 10 seconds"
                ToolTipService.ToolTip="Back 10 seconds">
          <Grid>
            <SymbolIcon x:Name="BackIcon" Symbol="Undo" />
            <TextBlock x:Name="BackSeconds" Text="10" FontSize="8" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0" />
          </Grid>
        </Button>

        <Button x:Name="PlayButton"
                Width="56" Height="56" CornerRadius="28" Padding="0"
                BorderThickness="0" Background="Transparent"
                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                IsEnabled="False" Click="OnPlayClick"
                AutomationProperties.Name="Play"
                ToolTipService.ToolTip="Play">
          <Grid>
            <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}" />
            <SymbolIcon x:Name="PlayIcon" Symbol="Play"
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
          </Grid>
        </Button>

        <Button x:Name="ForwardButton" Style="{StaticResource PlayerRoundButtonStyle}"
                IsEnabled="False" Click="OnForwardClick"
                AutomationProperties.Name="Forward 10 seconds"
                ToolTipService.ToolTip="Forward 10 seconds">
          <Grid>
            <SymbolIcon x:Name="ForwardIcon" Symbol="Redo" />
            <TextBlock x:Name="ForwardSeconds" Text="10" FontSize="8" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0" />
          </Grid>
        </Button>
      </StackPanel>

      <Button x:Name="SpeedButton" Grid.Column="2"
              HorizontalAlignment="Right" VerticalAlignment="Center"
              MinWidth="56" Height="44" CornerRadius="22" Padding="10,0"
              IsEnabled="False" Click="OnSpeedClick"
              AutomationProperties.Name="Playback speed"
              ToolTipService.ToolTip="Playback speed">
        <TextBlock x:Name="SpeedText" Text="1×" FontSize="13" />
      </Button>
    </Grid>

    <TextBlock x:Name="ErrorText" Grid.Row="2" Visibility="Collapsed"
               FontSize="12" TextWrapping="Wrap"
               Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
  </Grid>
</UserControl>
