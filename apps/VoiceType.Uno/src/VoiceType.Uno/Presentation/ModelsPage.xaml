<Page x:Class="VoiceType.Uno.Presentation.ModelsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:presentation="using:VoiceType.Uno.Presentation"
      xmlns:controls="using:VoiceType.Uno.Presentation.Controls"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
      KeyDown="Page_KeyDown"
      Loaded="Page_Loaded"
      SizeChanged="Page_SizeChanged">

  <Page.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="ModelsHintBrush" Color="#DBE9F8" />
          <SolidColorBrush x:Key="ModelsErrorBrush" Color="#C42B1C" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="ModelsHintBrush" Color="#1F3A52" />
          <SolidColorBrush x:Key="ModelsErrorBrush" Color="#FF99A4" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <!-- Card: surface + 1 px stroke, 8 px corners (mockup .model) -->
      <Style x:Key="ModelCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12" />
      </Style>

      <Style x:Key="HintBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource ModelsHintBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,10" />
      </Style>

      <Style x:Key="ChipStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8,2" />
      </Style>

      <Style x:Key="ChipTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="LineHeight" Value="16" />
      </Style>

      <Style x:Key="CardTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>

      <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Opacity" Value="0.75" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>

      <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Opacity" Value="0.7" />
      </Style>

      <Style x:Key="MetricValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>

      <!-- Every action is at least 44x44 (design doc §6.1) -->
      <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>

      <Style x:Key="AccentActionButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>

      <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>

      <!-- Segmented tab (mockup .m-tabs button): a RadioButton without the radio
           glyph; the checked segment gets a solid surface and semibold text. -->
      <Style x:Key="SegmentRadioButtonStyle" TargetType="RadioButton">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="RadioButton">
              <Grid x:Name="RootGrid" Background="{TemplateBinding Background}" CornerRadius="6">
                <VisualStateManager.VisualStateGroups>
                  <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                      <VisualState.Setters>
                        <Setter Target="HoverBorder.Opacity" Value="1" />
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                      <VisualState.Setters>
                        <Setter Target="HoverBorder.Opacity" Value="1" />
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                      <VisualState.Setters>
                        <Setter Target="ContentPresenter.Opacity" Value="0.4" />
                      </VisualState.Setters>
                    </VisualState>
                  </VisualStateGroup>
                  <VisualStateGroup x:Name="CheckStates">
                    <VisualState x:Name="Checked">
                      <VisualState.Setters>
                        <Setter Target="SelectedBorder.Opacity" Value="1" />
                        <Setter Target="ContentPresenter.FontWeight" Value="SemiBold" />
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Unchecked" />
                    <VisualState x:Name="Indeterminate" />
                  </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>

                <Border x:Name="HoverBorder" Opacity="0" CornerRadius="6"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}" />
                <Border x:Name="SelectedBorder" Opacity="0" CornerRadius="6"
                        Background="{ThemeResource ControlSolidFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1" />
                <ContentPresenter x:Name="ContentPresenter"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Padding="{TemplateBinding Padding}"
                                  Foreground="{TemplateBinding Foreground}"
                                  FontSize="{TemplateBinding FontSize}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  TextWrapping="NoWrap" />
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- One catalog model (Speech tab) -->
      <DataTemplate x:Key="SpeechCardTemplate" x:DataType="presentation:ModelCardViewModel">
        <Grid>
          <Border Style="{StaticResource ModelCardStyle}">
            <StackPanel Spacing="8">
              <TextBlock Text="{x:Bind Title}" Style="{StaticResource CardTitleStyle}" />

              <!-- Chips wrap onto the next line instead of overflowing -->
              <controls:ChipWrapPanel Spacing="4">
                <Border Style="{StaticResource ChipStyle}">
                  <TextBlock Text="{x:Bind PrecisionChip}" Style="{StaticResource ChipTextStyle}" />
                </Border>
                <Border Style="{StaticResource ChipStyle}">
                  <TextBlock Text="{x:Bind WindowChip}" Style="{StaticResource ChipTextStyle}" />
                </Border>
                <Border Style="{StaticResource ChipStyle}"
                        Background="{ThemeResource ModelsHintBrush}" BorderBrush="Transparent"
                        Visibility="{x:Bind ShowRecommendedBadge}">
                  <TextBlock Text="★ Recommended" Style="{StaticResource ChipTextStyle}" FontWeight="SemiBold" />
                </Border>
                <Border Style="{StaticResource ChipStyle}"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                        Visibility="{x:Bind ShowInUseBadge, Mode=OneWay}">
                  <TextBlock Text="● In use" Style="{StaticResource ChipTextStyle}"
                             Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>
                <Border Style="{StaticResource ChipStyle}" Visibility="{x:Bind ShowInstalledBadge, Mode=OneWay}">
                  <TextBlock Text="installed" Style="{StaticResource ChipTextStyle}" />
                </Border>
                <Border Style="{StaticResource ChipStyle}" Visibility="{x:Bind IsMostAccurate}">
                  <TextBlock Text="most accurate" Style="{StaticResource ChipTextStyle}" />
                </Border>
                <Border Style="{StaticResource ChipStyle}" Visibility="{x:Bind IsFastest}">
                  <TextBlock Text="fastest" Style="{StaticResource ChipTextStyle}" />
                </Border>
                <Border Style="{StaticResource ChipStyle}" Visibility="{x:Bind IsSmallest}">
                  <TextBlock Text="smallest" Style="{StaticResource ChipTextStyle}" />
                </Border>
              </controls:ChipWrapPanel>

              <TextBlock Text="{x:Bind Tagline}" FontSize="13" Opacity="0.75" TextWrapping="Wrap" />

              <!-- Three fixed-width metric columns -->
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Accuracy" Style="{StaticResource MetricLabelStyle}" />
                  <TextBlock Text="{x:Bind AccuracyText}" Style="{StaticResource MetricValueStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="Speed" Style="{StaticResource MetricLabelStyle}" />
                  <TextBlock Text="{x:Bind SpeedText}" Style="{StaticResource MetricValueStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Download" Style="{StaticResource MetricLabelStyle}" />
                  <TextBlock Text="{x:Bind SizeText}" Style="{StaticResource MetricValueStyle}" />
                </StackPanel>
              </Grid>

              <!-- Only while downloading -->
              <StackPanel Spacing="4" Visibility="{x:Bind IsDownloading, Mode=OneWay}">
                <ProgressBar Maximum="100"
                             Value="{x:Bind Progress, Mode=OneWay}"
                             IsIndeterminate="{x:Bind IsProgressIndeterminate, Mode=OneWay}" />
                <Grid ColumnSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{x:Bind ProgressText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
                  <TextBlock Grid.Column="1" Text="{x:Bind RateText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
                </Grid>
              </StackPanel>

              <!-- "Show details" from the ⋯ menu -->
              <StackPanel Spacing="4" Visibility="{x:Bind IsDetailsExpanded, Mode=OneWay}">
                <TextBlock Text="{x:Bind Description}" Style="{StaticResource SecondaryTextStyle}" />
                <TextBlock Style="{StaticResource SecondaryTextStyle}">
                  <Run Text="Word error rate by language:" />
                  <Run Text="{x:Bind AccuracyDetailText}" />
                </TextBlock>
                <TextBlock Style="{StaticResource SecondaryTextStyle}">
                  <Run Text="{x:Bind LatencyText}" />
                  <Run Text="·" />
                  <Run Text="{x:Bind UseCaseText}" />
                </TextBlock>
                <TextBlock Text="{x:Bind RatingSummary}" Style="{StaticResource SecondaryTextStyle}" />
              </StackPanel>

              <!-- One primary action by state + the ⋯ menu -->
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind StateText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}"
                           VerticalAlignment="Center" MaxLines="3" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="1" Content="Download" Style="{StaticResource AccentActionButtonStyle}"
                        Click="DownloadCard_Click"
                        Visibility="{x:Bind ShowDownloadAction, Mode=OneWay}" />
                <Button Grid.Column="1" Content="{x:Bind SecondaryActionText, Mode=OneWay}"
                        Style="{StaticResource ActionButtonStyle}"
                        Click="PrimaryCard_Click"
                        IsEnabled="{x:Bind IsSecondaryActionEnabled, Mode=OneWay}"
                        Visibility="{x:Bind ShowSecondaryAction, Mode=OneWay}" />
                <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Width="44" Height="44"
                        Click="MoreCard_Click"
                        AutomationProperties.Name="More actions"
                        ToolTipService.ToolTip="More actions">
                  <SymbolIcon Symbol="More" />
                </Button>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Accent frame of the model in use (drawn over the card stroke) -->
          <Border BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="2"
                  CornerRadius="8" IsHitTestVisible="False"
                  Visibility="{x:Bind ShowInUseBadge, Mode=OneWay}" />
        </Grid>
      </DataTemplate>

      <!-- One language model (Gemma tab) -->
      <DataTemplate x:Key="LlmCardTemplate" x:DataType="presentation:LlmModelCardViewModel">
        <Grid>
          <Border Style="{StaticResource ModelCardStyle}">
            <StackPanel Spacing="8">
              <TextBlock Text="{x:Bind Title}" Style="{StaticResource CardTitleStyle}" />

              <controls:ChipWrapPanel Spacing="4">
                <Border Style="{StaticResource ChipStyle}">
                  <TextBlock Text="{x:Bind SizeChip}" Style="{StaticResource ChipTextStyle}" />
                </Border>
                <Border Style="{StaticResource ChipStyle}">
                  <TextBlock Text="{x:Bind ContextChip}" Style="{StaticResource ChipTextStyle}" />
                </Border>
                <Border Style="{StaticResource ChipStyle}"
                        Background="{ThemeResource ModelsHintBrush}" BorderBrush="Transparent"
                        Visibility="{x:Bind ShowRecommendedChip}">
                  <TextBlock Text="★ Recommended" Style="{StaticResource ChipTextStyle}" FontWeight="SemiBold" />
                </Border>
                <Border Style="{StaticResource ChipStyle}" Visibility="{x:Bind ShowDesktopOnlyChip}">
                  <TextBlock Text="Desktop only" Style="{StaticResource ChipTextStyle}" />
                </Border>
                <Border Style="{StaticResource ChipStyle}"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                        Visibility="{x:Bind ShowInUseChip, Mode=OneWay}">
                  <TextBlock Text="● In use" Style="{StaticResource ChipTextStyle}"
                             Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>
                <Border Style="{StaticResource ChipStyle}" Visibility="{x:Bind ShowInstalledChip, Mode=OneWay}">
                  <TextBlock Text="installed" Style="{StaticResource ChipTextStyle}" />
                </Border>
                <Border Style="{StaticResource ChipStyle}" BorderBrush="{ThemeResource ModelsErrorBrush}"
                        Visibility="{x:Bind ShowLowMemoryChip, Mode=OneWay}">
                  <TextBlock Text="⚠ Low memory" Style="{StaticResource ChipTextStyle}"
                             Foreground="{ThemeResource ModelsErrorBrush}" FontWeight="SemiBold" />
                </Border>
              </controls:ChipWrapPanel>

              <TextBlock Text="{x:Bind Tagline}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{x:Bind Description}" Style="{StaticResource SecondaryTextStyle}" />
              <TextBlock Text="{x:Bind RamText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
              <TextBlock Text="{x:Bind RamWarningText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}"
                         Foreground="{ThemeResource ModelsErrorBrush}" Opacity="1"
                         Visibility="{x:Bind ShowLowMemoryChip, Mode=OneWay}" />

              <!-- Only while downloading: bar, "42% · 1.0 / 2.4 GB · 3.1 MB/s · 7 min" -->
              <StackPanel Spacing="4" Visibility="{x:Bind ShowProgress, Mode=OneWay}">
                <ProgressBar Maximum="100" Value="{x:Bind Percent, Mode=OneWay}" />
                <TextBlock Text="{x:Bind RateText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
              </StackPanel>

              <!-- One primary action by state + the ⋯ menu -->
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}"
                           VerticalAlignment="Center" MaxLines="3" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="1" Content="{x:Bind ActionText, Mode=OneWay}"
                        Style="{StaticResource AccentActionButtonStyle}"
                        Click="LlmPrimary_Click"
                        IsEnabled="{x:Bind ActionEnabled, Mode=OneWay}"
                        Visibility="{x:Bind ShowAccentAction, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind PrimaryAutomationName, Mode=OneWay}" />
                <Button Grid.Column="1" Content="{x:Bind ActionText, Mode=OneWay}"
                        Style="{StaticResource ActionButtonStyle}"
                        Click="LlmPrimary_Click"
                        IsEnabled="{x:Bind ActionEnabled, Mode=OneWay}"
                        Visibility="{x:Bind ShowPlainAction, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind PrimaryAutomationName, Mode=OneWay}" />
                <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Width="44" Height="44"
                        Click="LlmMore_Click"
                        Visibility="{x:Bind CanDelete, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind MoreAutomationName}"
                        ToolTipService.ToolTip="More actions">
                  <SymbolIcon Symbol="More" />
                </Button>
              </Grid>
            </StackPanel>
          </Border>

          <Border BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="2"
                  CornerRadius="8" IsHitTestVisible="False"
                  Visibility="{x:Bind ShowInUseChip, Mode=OneWay}" />
        </Grid>
      </DataTemplate>

      <!-- One job (Downloads tab) -->
      <DataTemplate x:Key="DownloadItemTemplate" x:DataType="presentation:DownloadItemViewModel">
        <Border Style="{StaticResource ModelCardStyle}">
          <StackPanel Spacing="8">
            <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" Style="{StaticResource CardTitleStyle}" />

            <StackPanel Spacing="4">
              <ProgressBar Maximum="100"
                           Value="{x:Bind Percent, Mode=OneWay}"
                           IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}"
                           Visibility="{x:Bind IsProgressVisible, Mode=OneWay}" />
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind DetailText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
                <TextBlock Text="{x:Bind ErrorText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}"
                           Foreground="{ThemeResource ModelsErrorBrush}" Opacity="1" />
                <TextBlock Grid.Column="1" Text="{x:Bind TransferText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
              </Grid>
            </StackPanel>

            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{x:Bind StateText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}"
                         VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="Remove" Style="{StaticResource ActionButtonStyle}"
                        Command="{x:Bind RemoveCommand}"
                        Visibility="{x:Bind IsFinished, Mode=OneWay}" />
                <Button Content="Retry" Style="{StaticResource AccentActionButtonStyle}"
                        Command="{x:Bind RetryCommand}"
                        Visibility="{x:Bind IsFailed, Mode=OneWay}" />
                <Button Content="Cancel" Style="{StaticResource ActionButtonStyle}"
                        Command="{x:Bind CancelCommand}"
                        Visibility="{x:Bind IsRunning, Mode=OneWay}" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>
      </DataTemplate>
    </ResourceDictionary>
  </Page.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />  <!-- 0 top bar -->
      <RowDefinition Height="Auto" />  <!-- 1 tabs -->
      <RowDefinition Height="*" />     <!-- 2 content -->
    </Grid.RowDefinitions>

    <!-- Top bar: back, title + subtitle, refresh -->
    <Grid Grid.Row="0" MinHeight="56" Padding="4,4,4,4" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="48" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="48" />
      </Grid.ColumnDefinitions>
      <Button x:Name="BackButton" Style="{StaticResource IconButtonStyle}" Click="Back_Click"
              AutomationProperties.Name="Back" ToolTipService.ToolTip="Back">
        <Button.KeyboardAccelerators>
          <KeyboardAccelerator Key="Escape" />
        </Button.KeyboardAccelerators>
        <SymbolIcon Symbol="Back" />
      </Button>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock Text="Models" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="{x:Bind Models.InstalledSummaryText, Mode=OneWay}"
                   FontSize="12" Opacity="0.7" TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Click="Refresh_Click"
              AutomationProperties.Name="Refresh" ToolTipService.ToolTip="Check the models on disk again">
        <SymbolIcon Symbol="Refresh" />
      </Button>
    </Grid>

    <!-- Segmented tabs: Speech | Translation | Downloads · N -->
    <Border Grid.Row="1" MaxWidth="760" Margin="16,0,16,8" Padding="2" CornerRadius="8"
            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
      <Grid ColumnSpacing="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <RadioButton x:Name="SpeechTab" GroupName="ModelsTabs" Content="Speech"
                     Style="{StaticResource SegmentRadioButtonStyle}" Checked="Tab_Checked" />
        <RadioButton x:Name="TranslationTab" Grid.Column="1" GroupName="ModelsTabs" Content="Gemma"
                     Style="{StaticResource SegmentRadioButtonStyle}" Checked="Tab_Checked" />
        <RadioButton x:Name="DownloadsTab" Grid.Column="2" GroupName="ModelsTabs"
                     Content="{x:Bind Downloads.TabLabel, Mode=OneWay}"
                     Style="{StaticResource SegmentRadioButtonStyle}" Checked="Tab_Checked" />
      </Grid>
    </Border>

    <ScrollViewer x:Name="ContentScroll" Grid.Row="2"
                  HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <Grid MaxWidth="760" Margin="16,0,16,16">

        <!-- Speech -->
        <StackPanel x:Name="SpeechPane" Spacing="8">
          <Border Style="{StaticResource HintBorderStyle}">
            <StackPanel>
              <TextBlock Text="Which model should I download?" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{x:Bind Models.RecommendationText, Mode=OneWay}" FontSize="13" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <TextBlock Text="{x:Bind Models.StatusText, Mode=OneWay}" FontSize="12" TextWrapping="Wrap"
                     Visibility="{x:Bind Models.HasStatus, Mode=OneWay}" />

          <ItemsControl x:Name="SpeechCards" ItemsSource="{x:Bind Models.Cards}" Loaded="SpeechCards_Loaded"
                        ItemTemplate="{StaticResource SpeechCardTemplate}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <!-- Two columns when the page is ≥ 840 px wide (set from code-behind), one below -->
                <controls:CardColumnsPanel MinColumnWidth="300" MaxColumns="1" Spacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>

          <TextBlock Style="{StaticResource SecondaryTextStyle}" FontSize="11"
                     Text="Accuracy: word error rate on Common Voice 17 ru/en (lower is better). Speed: CPU throughput. Several downloads run in parallel; a downloaded model becomes the active one." />
          <TextBlock Text="{x:Bind Models.StorageText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" FontSize="11" />
        </StackPanel>

        <!-- Gemma: the on-device language model(s) -->
        <StackPanel x:Name="TranslationPane" Spacing="8" Visibility="Collapsed">
          <StackPanel x:Name="LlmPanel" Spacing="8">
            <Border Style="{StaticResource HintBorderStyle}">
              <StackPanel>
                <TextBlock Text="One on-device language model" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock FontSize="13" TextWrapping="Wrap"
                           Text="Gemma (LiteRT-LM) translates, answers chat questions and writes titles. Nothing is sent to a server." />
              </StackPanel>
            </Border>

            <!-- Switching progress -->
            <Border Style="{StaticResource HintBorderStyle}" Visibility="{x:Bind LlmModels.IsLoading, Mode=OneWay}">
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ProgressRing Width="24" Height="24" IsActive="{x:Bind LlmModels.IsLoading, Mode=OneWay}" />
                <TextBlock Grid.Column="1" Text="{x:Bind LlmModels.LoadingText, Mode=OneWay}" FontSize="13"
                           TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
              </Grid>
            </Border>

            <!-- Switch / load failure -->
            <Border Style="{StaticResource HintBorderStyle}" Visibility="{x:Bind LlmModels.HasError, Mode=OneWay}">
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind LlmModels.ErrorText, Mode=OneWay}" FontSize="13" TextWrapping="Wrap"
                           Foreground="{ThemeResource ModelsErrorBrush}" VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Assertive" />
                <Button Grid.Column="1" Content="Dismiss" Style="{StaticResource ActionButtonStyle}" Click="LlmDismissError_Click" />
              </Grid>
            </Border>

            <ItemsControl x:Name="LlmCards" ItemsSource="{x:Bind LlmModels.Cards}"
                          ItemTemplate="{StaticResource LlmCardTemplate}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <controls:CardColumnsPanel MinColumnWidth="300" MaxColumns="1" Spacing="8" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- Compute: CPU | GPU for the language model -->
            <Border Style="{StaticResource ModelCardStyle}">
              <StackPanel Spacing="8">
                <TextBlock Text="Compute" Style="{StaticResource CardTitleStyle}" />
                <Border Padding="2" CornerRadius="8" HorizontalAlignment="Stretch" MaxWidth="320"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        Visibility="{x:Bind LlmModels.IsComputeChoiceAvailable}">
                  <Grid ColumnSpacing="2">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <RadioButton x:Name="CpuRadio" GroupName="LlmCompute" Content="CPU"
                                 Style="{StaticResource SegmentRadioButtonStyle}" Checked="Compute_Checked"
                                 AutomationProperties.Name="Language model on the CPU" />
                    <RadioButton x:Name="GpuRadio" Grid.Column="1" GroupName="LlmCompute" Content="GPU"
                                 Style="{StaticResource SegmentRadioButtonStyle}" Checked="Compute_Checked"
                                 AutomationProperties.Name="Language model on the GPU" />
                  </Grid>
                </Border>
                <TextBlock Text="{x:Bind LlmModels.ComputeHint}" Style="{StaticResource SecondaryTextStyle}" />
              </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SecondaryTextStyle}" FontSize="11" Text="{x:Bind LlmSharedNote}" />
          </StackPanel>

          <!-- Fallback when no ILlmModelService is registered: the single Gemma 4 E2B card -->
          <StackPanel x:Name="LegacyTranslationPanel" Spacing="8" Visibility="Collapsed">
          <Border Style="{StaticResource HintBorderStyle}">
            <StackPanel>
              <TextBlock Text="Live translation runs on the device" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock FontSize="13" TextWrapping="Wrap"
                         Text="Gemma 4 E2B (LiteRT-LM) translates the transcript sentence by sentence; nothing is sent to a server." />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource ModelCardStyle}">
            <StackPanel Spacing="8">
              <TextBlock Text="{x:Bind TranslationModel.Title}" Style="{StaticResource CardTitleStyle}" />
              <controls:ChipWrapPanel Spacing="4">
                <Border Style="{StaticResource ChipStyle}">
                  <TextBlock Text="LiteRT-LM" Style="{StaticResource ChipTextStyle}" />
                </Border>
                <Border Style="{StaticResource ChipStyle}">
                  <TextBlock Text="CPU" Style="{StaticResource ChipTextStyle}" />
                </Border>
                <Border Style="{StaticResource ChipStyle}"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                        Visibility="{x:Bind TranslationModel.IsInstalled, Mode=OneWay}">
                  <TextBlock Text="installed" Style="{StaticResource ChipTextStyle}"
                             Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>
              </controls:ChipWrapPanel>
              <TextBlock Text="{x:Bind TranslationModel.FileText}" FontSize="13" Opacity="0.75" TextWrapping="Wrap" />

              <StackPanel Spacing="4">
                <ProgressBar Maximum="100"
                             Value="{x:Bind TranslationModel.Progress, Mode=OneWay}"
                             IsIndeterminate="{x:Bind TranslationModel.IsProgressIndeterminate, Mode=OneWay}"
                             Visibility="{x:Bind TranslationModel.IsProgressVisible, Mode=OneWay}" />
                <Grid ColumnSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{x:Bind TranslationModel.StatusText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
                  <TextBlock Grid.Column="1" Text="{x:Bind TranslationModel.DetailText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
                </Grid>
                <TextBlock Text="{x:Bind TranslationModel.RateText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}"
                           Visibility="{x:Bind TranslationModel.IsProgressVisible, Mode=OneWay}" />
              </StackPanel>

              <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Content="Delete" Style="{StaticResource ActionButtonStyle}"
                        Click="DeleteTranslation_Click"
                        Visibility="{x:Bind TranslationModel.CanDelete, Mode=OneWay}" />
                <Button Content="Cancel" Style="{StaticResource ActionButtonStyle}"
                        Click="CancelTranslation_Click"
                        Visibility="{x:Bind TranslationModel.IsDownloading, Mode=OneWay}" />
                <Button Content="{x:Bind TranslationModel.DownloadText, Mode=OneWay}" Style="{StaticResource AccentActionButtonStyle}"
                        Click="DownloadTranslation_Click"
                        Visibility="{x:Bind TranslationModel.CanDownload, Mode=OneWay}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <TextBlock Style="{StaticResource SecondaryTextStyle}" FontSize="11"
                     Text="Turn on live translation from the menu on the main screen. The model is used for every target language." />
          </StackPanel>
        </StackPanel>

        <!-- Downloads -->
        <StackPanel x:Name="DownloadsPane" Spacing="8" Visibility="Collapsed">
          <Border Style="{StaticResource ModelCardStyle}" Visibility="{x:Bind Downloads.HasItems, Mode=OneWay}">
            <StackPanel Spacing="8">
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Downloads.AggregateText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Grid.Column="1" Text="{x:Bind Downloads.AggregateTransferText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
              </Grid>
              <ProgressBar Maximum="100" Value="{x:Bind Downloads.AggregatePercent, Mode=OneWay}" />
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Downloads run in parallel; Retry resumes partial files."
                           Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Clear finished" Style="{StaticResource ActionButtonStyle}"
                        Command="{x:Bind Downloads.ClearFinishedCommand}"
                        IsEnabled="{x:Bind Downloads.HasFinished, Mode=OneWay}" />
              </Grid>
            </StackPanel>
          </Border>

          <TextBlock Text="No downloads yet. Pick a model on the Speech or Gemma tab and press Download."
                     Style="{StaticResource SecondaryTextStyle}" FontSize="13" Margin="0,8,0,0"
                     Visibility="{x:Bind Downloads.IsEmpty, Mode=OneWay}" />

          <ItemsControl ItemsSource="{x:Bind Downloads.Items}"
                        ItemTemplate="{StaticResource DownloadItemTemplate}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </Grid>
</Page>
