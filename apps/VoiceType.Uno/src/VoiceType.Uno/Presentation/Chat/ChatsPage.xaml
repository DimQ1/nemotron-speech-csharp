<Page x:Class="VoiceType.Uno.Presentation.Chat.ChatsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:chat="using:VoiceType.Uno.Presentation.Chat"
      xmlns:history="using:VoiceType.Uno.Presentation.History"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
      KeyDown="Page_KeyDown"
      Loaded="Page_Loaded"
      Unloaded="Page_Unloaded"
      SizeChanged="Page_SizeChanged">

  <!-- Chats (design §4.4): top-level list of chats, each over one or more recordings. From 840 px:
       master-detail, list 360 px on the left and the chat on the right (a nested Frame hosting ChatPage). -->
  <Page.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <history:HistoryStyles />
      </ResourceDictionary.MergedDictionaries>

      <DataTemplate x:Key="RowTemplate" x:DataType="chat:ChatRowViewModel">
        <Grid MinHeight="76">
          <Border Style="{StaticResource HistoryCardStyle}" />
          <Border CornerRadius="8" BorderThickness="1.5"
                  Background="{ThemeResource HistorySelectedBrush}"
                  BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                  Visibility="{x:Bind IsHighlighted, Mode=OneWay}" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource HistoryRowButtonStyle}" Padding="12,10,4,10" Click="Row_Click"
                    AutomationProperties.Name="{x:Bind AutomationName}">
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE8BD;" FontSize="20" Opacity="0.7" VerticalAlignment="Top" Margin="0,2,0,0" />
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="{x:Bind Title}" Style="{StaticResource HistoryTitleStyle}"
                             MaxLines="2" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{x:Bind Meta}" Style="{StaticResource HistorySecondaryStyle}"
                             TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{x:Bind LastLine}" Style="{StaticResource HistorySecondaryStyle}" FontStyle="Italic"
                             MaxLines="2" TextTrimming="CharacterEllipsis" Visibility="{x:Bind HasLastLine}" />
                </StackPanel>
              </Grid>
            </Button>
            <Button Grid.Column="1" Width="44" Height="44" Margin="0,0,4,0" Padding="0"
                    Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                    Click="RowMore_Click" AutomationProperties.Name="More actions" ToolTipService.ToolTip="More actions">
              <SymbolIcon Symbol="More" />
            </Button>
          </Grid>
        </Grid>
      </DataTemplate>
    </ResourceDictionary>
  </Page.Resources>

  <Grid x:Name="LayoutRoot">
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="ListColumn" Width="*" />
      <ColumnDefinition x:Name="DetailColumn" Width="0" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ── List ─────────────────────────────────────────────────────── -->
    <Grid x:Name="ListPane" Grid.Row="0" Grid.Column="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />  <!-- 0 top bar -->
        <RowDefinition Height="Auto" />  <!-- 1 search -->
        <RowDefinition Height="*" />     <!-- 2 list -->
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" MinHeight="56" Padding="4" ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="48" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="48" />
        </Grid.ColumnDefinitions>
        <Button x:Name="BackButton" Style="{StaticResource HistoryIconButtonStyle}" Click="Back_Click"
                AutomationProperties.Name="Back" ToolTipService.ToolTip="Back">
          <SymbolIcon Symbol="Back" />
        </Button>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="Chats" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" FontSize="12" Opacity="0.7"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Button Grid.Column="2" Style="{StaticResource HistoryIconButtonStyle}" Click="NewChat_Click"
                AutomationProperties.Name="New chat" ToolTipService.ToolTip="New chat">
          <SymbolIcon Symbol="Add" />
        </Button>
      </Grid>

      <TextBox x:Name="SearchBox" Grid.Row="1" Margin="16,0,16,8" MinHeight="44" VerticalContentAlignment="Center"
               PlaceholderText="Search chats" AutomationProperties.Name="Search chats"
               TextChanged="SearchBox_TextChanged" />

      <ScrollViewer x:Name="ListScroll" Grid.Row="2" HorizontalScrollMode="Disabled"
                    HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8,0,8,16" Spacing="8">
          <ItemsControl ItemsSource="{x:Bind ViewModel.Rows}" ItemTemplate="{StaticResource RowTemplate}"
                        IsTabStop="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>

          <!-- Empty state -->
          <StackPanel Margin="8,32,8,16" Spacing="8" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
            <FontIcon Glyph="&#xE8BD;" FontSize="40" Opacity="0.5" HorizontalAlignment="Left" />
            <TextBlock Text="No chats yet" Style="{StaticResource HistoryTitleStyle}" FontSize="18" />
            <TextBlock Style="{StaticResource HistorySecondaryStyle}" FontSize="13"
                       Text="Ask Gemma about one recording or several at once. It reads them on this device; nothing leaves it." />
            <Button Style="{StaticResource HistoryAccentButtonStyle}" Click="NewChat_Click" HorizontalAlignment="Left"
                    AutomationProperties.Name="New chat from the empty state">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="✦" FontSize="14" />
                <TextBlock Text="New chat" />
              </StackPanel>
            </Button>
          </StackPanel>
          <TextBlock Margin="8,24,8,0" Text="No chats match the search" Style="{StaticResource HistorySecondaryStyle}"
                     FontSize="13" Visibility="{x:Bind ViewModel.HasNoMatches, Mode=OneWay}" />
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- ── Detail (≥ 840 px) ───────────────────────────────────────── -->
    <Grid x:Name="DetailPane" Grid.Row="0" Grid.Column="1" Visibility="Collapsed"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
      <StackPanel x:Name="DetailPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center"
                  Spacing="8" MaxWidth="360" Padding="16">
        <FontIcon Glyph="&#xE8BD;" FontSize="40" Opacity="0.5" />
        <TextBlock Text="Select a chat" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <TextBlock Text="Or start a new one with the + button." Style="{StaticResource HistorySecondaryStyle}"
                   TextAlignment="Center" />
      </StackPanel>
      <Frame x:Name="DetailFrame" Visibility="Collapsed" />
    </Grid>

    <history:UndoSnackbar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" />
  </Grid>
</Page>
