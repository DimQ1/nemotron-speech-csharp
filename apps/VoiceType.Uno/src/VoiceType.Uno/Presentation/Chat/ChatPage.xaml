<Page x:Class="VoiceType.Uno.Presentation.Chat.ChatPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:chat="using:VoiceType.Uno.Presentation.Chat"
      xmlns:history="using:VoiceType.Uno.Presentation.History"
      xmlns:hist="using:VoiceType.Uno.History"
      xmlns:controls="using:VoiceType.Uno.Presentation.Controls"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
      KeyDown="Page_KeyDown"
      Loaded="Page_Loaded"
      Unloaded="Page_Unloaded"
      SizeChanged="Page_SizeChanged">

  <!-- Chat (design §4.4): header · sources (chips, or one summary row on narrow / low windows or
       while the keyboard is open) · notices · thread · error · composer. Every element names its
       Grid.Row, so a collapsed Auto row never shifts the others. -->
  <Page.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <history:HistoryStyles />
      </ResourceDictionary.MergedDictionaries>

      <DataTemplate x:Key="CitationTemplate" x:DataType="hist:ChatCitationChip">
        <Button MinHeight="44" CornerRadius="22" Padding="14,0" Click="Citation_Click"
                Background="{ThemeResource HistoryHintBrush}" BorderThickness="0"
                IsEnabled="{x:Bind RecordingExists}"
                AutomationProperties.Name="{x:Bind AutomationName}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <FontIcon Glyph="&#xE768;" FontSize="10" VerticalAlignment="Center" />
            <TextBlock Text="{x:Bind Label}" FontSize="13" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </DataTemplate>

      <DataTemplate x:Key="SourceChipTemplate" x:DataType="chat:SourceChipViewModel">
        <Button MinHeight="44" CornerRadius="22" Padding="14,0" Click="SourceChip_Click"
                AutomationProperties.Name="{x:Bind AutomationName}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="{x:Bind Label}" FontSize="13" VerticalAlignment="Center" />
            <Ellipse Width="8" Height="8" Fill="{ThemeResource HistoryWarningStrokeBrush}" VerticalAlignment="Center"
                     Visibility="{x:Bind IsOutdated}" />
          </StackPanel>
        </Button>
      </DataTemplate>

      <DataTemplate x:Key="QuickPromptTemplate" x:DataType="chat:QuickPromptViewModel">
        <Button MinHeight="48" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14,0"
                Click="QuickPrompt_Click" AutomationProperties.Name="{x:Bind AutomationName}">
          <TextBlock Text="{x:Bind Label}" FontSize="14" TextTrimming="CharacterEllipsis" />
        </Button>
      </DataTemplate>

      <DataTemplate x:Key="MessageTemplate" x:DataType="chat:ChatMessageViewModel">
        <Grid Margin="0,2">
          <!-- Source change event -->
          <Border Visibility="{x:Bind IsEvent}" HorizontalAlignment="Center" Margin="0,8"
                  Style="{StaticResource HistoryHintStyle}" Padding="14,6">
            <TextBlock Text="{x:Bind Text, Mode=OneWay}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" />
          </Border>

          <!-- You -->
          <StackPanel Visibility="{x:Bind IsUser}" HorizontalAlignment="Right" Spacing="2">
            <TextBlock Text="{x:Bind RoleLabel}" Visibility="{x:Bind ShowRole}" FontSize="11" Opacity="0.7"
                       HorizontalAlignment="Right" Margin="0,6,4,0" />
            <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="16,16,4,16" Padding="14,10"
                    HorizontalAlignment="Right" MaxWidth="{x:Bind Layout.BubbleMaxWidth, Mode=OneWay}">
              <TextBlock Text="{x:Bind Text, Mode=OneWay}" FontSize="15" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                         Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
            </Border>
            <TextBlock Text="{x:Bind TimeText}" Visibility="{x:Bind HasTime}" FontSize="11" Opacity="0.6"
                       HorizontalAlignment="Right" Margin="0,0,4,0" />
          </StackPanel>

          <!-- Gemma -->
          <StackPanel Visibility="{x:Bind IsAssistant}" HorizontalAlignment="Left" Spacing="2"
                      MaxWidth="{x:Bind Layout.BubbleMaxWidth, Mode=OneWay}">
            <TextBlock Text="{x:Bind RoleLabel}" Visibility="{x:Bind ShowRole}" FontSize="11" Opacity="0.7"
                       Margin="4,6,0,0" />
            <Border Style="{StaticResource HistoryCardStyle}" CornerRadius="16,16,16,4" Padding="14,10"
                    HorizontalAlignment="Left" MinWidth="64">
              <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind HasStatus, Mode=OneWay}">
                  <ProgressRing Width="16" Height="16" IsActive="{x:Bind ShowProgress, Mode=OneWay}"
                                Visibility="{x:Bind ShowProgress, Mode=OneWay}" />
                  <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" FontSize="12" Opacity="0.75"
                             TextWrapping="Wrap" VerticalAlignment="Center" />
                </StackPanel>
                <chat:ChatTextView Text="{x:Bind Text, Mode=OneWay}" />
                <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind IsIncomplete, Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind IncompleteText, Mode=OneWay}">
                  <FontIcon Glyph="&#xE7BA;" FontSize="12" Foreground="{ThemeResource HistoryWarningStrokeBrush}"
                            VerticalAlignment="Center" />
                  <TextBlock Text="{x:Bind IncompleteText, Mode=OneWay}" FontSize="12" TextWrapping="Wrap"
                             Foreground="{ThemeResource HistoryWarningStrokeBrush}" />
                </StackPanel>
              </StackPanel>
            </Border>
            <ItemsControl ItemsSource="{x:Bind Citations, Mode=OneWay}" ItemTemplate="{StaticResource CitationTemplate}"
                          Visibility="{x:Bind HasCitations, Mode=OneWay}" IsTabStop="False" Margin="0,4,0,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <controls:ChipWrapPanel Spacing="8" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
            <Grid Visibility="{x:Bind ShowFooter, Mode=OneWay}" ColumnSpacing="4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Button Style="{StaticResource HistoryIconButtonStyle}" Width="44" Height="44" Click="Copy_Click"
                      IsEnabled="{x:Bind CanCopy, Mode=OneWay}"
                      AutomationProperties.Name="Copy answer" ToolTipService.ToolTip="Copy answer">
                <SymbolIcon Symbol="Copy" />
              </Button>
              <TextBlock Grid.Column="1" Text="{x:Bind TimeText, Mode=OneWay}" Visibility="{x:Bind HasTime, Mode=OneWay}"
                         FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
            </Grid>
          </StackPanel>
        </Grid>
      </DataTemplate>
    </ResourceDictionary>
  </Page.Resources>

  <Grid x:Name="LayoutRoot" MaxWidth="900" HorizontalAlignment="Stretch">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />  <!-- 0 header -->
      <RowDefinition Height="Auto" />  <!-- 1 sources -->
      <RowDefinition Height="Auto" />  <!-- 2 banners (model, outdated source) -->
      <RowDefinition Height="*" />     <!-- 3 thread -->
      <RowDefinition Height="Auto" />  <!-- 4 error -->
      <RowDefinition Height="Auto" />  <!-- 5 composer -->
    </Grid.RowDefinitions>

    <!-- Header: back · title + summary (rename) · ⋯ -->
    <Grid x:Name="Header" Grid.Row="0" MinHeight="56" Padding="4" ColumnSpacing="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="BackColumn" Width="48" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="48" />
      </Grid.ColumnDefinitions>
      <Button x:Name="BackButton" Style="{StaticResource HistoryIconButtonStyle}" Click="Back_Click"
              AutomationProperties.Name="Back" ToolTipService.ToolTip="Back">
        <SymbolIcon Symbol="Back" />
      </Button>
      <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="8,0" MinHeight="48"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalAlignment="Center"
              Click="Rename_Click" AutomationProperties.Name="Rename chat" ToolTipService.ToolTip="Rename chat">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" FontSize="18" FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
          <TextBlock Text="{x:Bind ViewModel.HeaderSubtitle, Mode=OneWay}" FontSize="12" Opacity="0.7"
                     TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
        </StackPanel>
      </Button>
      <Button Grid.Column="2" Style="{StaticResource HistoryIconButtonStyle}" Click="More_Click"
              AutomationProperties.Name="Chat actions" ToolTipService.ToolTip="More actions">
        <SymbolIcon Symbol="More" />
      </Button>
    </Grid>

    <!-- Sources: chips from 600x480, otherwise one summary row + "+" (design §4.4) -->
    <StackPanel x:Name="SourcesPane" Grid.Row="1" Margin="16,0,16,8" Spacing="6">
      <ItemsControl x:Name="ChipsPanel" ItemsSource="{x:Bind ViewModel.Sources}"
                    ItemTemplate="{StaticResource SourceChipTemplate}" IsTabStop="False">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <controls:ChipWrapPanel Spacing="8" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
      <Button x:Name="AddChip" HorizontalAlignment="Left" MinHeight="44" CornerRadius="22" Padding="14,0"
              Click="AddRecordings_Click" AutomationProperties.Name="Add recording">
        <TextBlock Text="+ Add recording" FontSize="13" />
      </Button>
      <TextBlock x:Name="ContextText" Text="{x:Bind ViewModel.ContextLine, Mode=OneWay}"
                 Style="{StaticResource HistorySecondaryStyle}" />

      <Grid x:Name="SummaryRow" ColumnSpacing="4" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="44" />
        </Grid.ColumnDefinitions>
        <Button MinHeight="44" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12,0"
                Click="Sources_Click" AutomationProperties.Name="Sources">
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE8FD;" FontSize="14" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SourcesSummary, Mode=OneWay}" FontSize="13"
                       FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.SourcesDetail, Mode=OneWay}" FontSize="12" Opacity="0.7"
                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" />
            <FontIcon Grid.Column="3" Glyph="&#xE70D;" FontSize="12" VerticalAlignment="Center" />
          </Grid>
        </Button>
        <Button Grid.Column="1" Width="44" Height="44" Padding="0" Click="AddRecordings_Click"
                AutomationProperties.Name="Add recording" ToolTipService.ToolTip="Add recording">
          <SymbolIcon Symbol="Add" />
        </Button>
      </Grid>
    </StackPanel>

    <!-- Banners: model not installed, outdated source, no sources -->
    <StackPanel x:Name="BannerPane" Grid.Row="2" Margin="16,0,16,8" Spacing="8">
      <Border Style="{StaticResource HistoryHintStyle}" Visibility="{x:Bind ViewModel.ModelMissing, Mode=OneWay}">
        <Grid ColumnSpacing="12" RowSpacing="4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="{x:Bind ViewModel.ModelBannerTitle, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{x:Bind ViewModel.ModelBannerDetail, Mode=OneWay}" Style="{StaticResource HistorySecondaryStyle}" />
          </StackPanel>
          <Button Grid.Column="1" Content="Download" Style="{StaticResource HistoryAccentButtonStyle}"
                  Click="DownloadModel_Click" Visibility="{x:Bind ViewModel.CanDownload, Mode=OneWay}"
                  AutomationProperties.Name="Download Gemma" />
        </Grid>
      </Border>

      <Border Style="{StaticResource HistoryHintStyle}" Visibility="{x:Bind ViewModel.ShowNotice, Mode=OneWay}"
              Background="{ThemeResource HistoryWarningChipBrush}">
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{x:Bind ViewModel.NoticeText, Mode=OneWay}" FontSize="12" TextWrapping="Wrap"
                     VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="{x:Bind ViewModel.NoticeAction, Mode=OneWay}"
                  Style="{StaticResource HistoryActionButtonStyle}" Click="Notice_Click"
                  AutomationProperties.Name="Update outdated source" />
        </Grid>
      </Border>

      <Border Style="{StaticResource HistoryHintStyle}" Visibility="{x:Bind ViewModel.NoSources, Mode=OneWay}">
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="This chat has no recordings left. Earlier messages stay readable." FontSize="13"
                     TextWrapping="Wrap" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="Add recording" Style="{StaticResource HistoryActionButtonStyle}"
                  Click="AddRecordings_Click" AutomationProperties.Name="Add a recording to continue" />
        </Grid>
      </Border>
    </StackPanel>

    <!-- Thread -->
    <Grid Grid.Row="3">
      <ScrollViewer x:Name="MessagesScroll" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="MessagesList" ItemsSource="{x:Bind ViewModel.Messages}"
                      ItemTemplate="{StaticResource MessageTemplate}" IsTabStop="False" Margin="16,4,16,8" />
      </ScrollViewer>

      <!-- Empty chat: title + one-tap questions -->
      <ScrollViewer x:Name="EmptyPane" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled"
                    Visibility="{x:Bind ViewModel.IsEmptyThread, Mode=OneWay}">
        <StackPanel Margin="16,16,16,16" Spacing="12" VerticalAlignment="Center" MaxWidth="640">
          <FontIcon Glyph="&#xE8BD;" FontSize="36" Opacity="0.5" HorizontalAlignment="Left" />
          <TextBlock x:Name="EmptyTitle" Text="Ask Gemma about this recording" Style="{StaticResource HistoryTitleStyle}" FontSize="18" />
          <TextBlock x:Name="EmptyText" Style="{StaticResource HistorySecondaryStyle}" FontSize="13"
                     Text="Gemma reads the transcript on this device. Nothing leaves it." />
          <ItemsControl ItemsSource="{x:Bind ViewModel.QuickPrompts}" ItemTemplate="{StaticResource QuickPromptTemplate}"
                        Visibility="{x:Bind ViewModel.ShowQuickPrompts, Mode=OneWay}" IsTabStop="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <controls:CardColumnsPanel MinColumnWidth="250" MaxColumns="2" Spacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- Error with Retry -->
    <Border x:Name="ErrorPane" Grid.Row="4" Margin="16,0,16,8" Style="{StaticResource HistoryHintStyle}"
            Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Background="{ThemeResource HistoryWarningChipBrush}">
      <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="44" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{x:Bind ViewModel.Error, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
        <Button Grid.Column="1" Content="Retry" Style="{StaticResource HistoryActionButtonStyle}" Click="Retry_Click"
                IsEnabled="{x:Bind ViewModel.CanRetry, Mode=OneWay}" AutomationProperties.Name="Retry" />
        <Button Grid.Column="2" Width="44" Height="44" Padding="0" Background="Transparent" BorderThickness="0"
                Click="DismissError_Click" AutomationProperties.Name="Dismiss error" ToolTipService.ToolTip="Dismiss">
          <SymbolIcon Symbol="Cancel" />
        </Button>
      </Grid>
    </Border>

    <!-- Composer: lifted above the on-screen keyboard by the SoftInput safe-area inset -->
    <Border Grid.Row="5" utu:SafeArea.Insets="SoftInput">
      <Grid x:Name="Composer" Padding="8,4,8,8" ColumnSpacing="4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="44" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="44" />
        </Grid.ColumnDefinitions>
        <Button Style="{StaticResource HistoryIconButtonStyle}" Width="44" Height="44" VerticalAlignment="Bottom"
                Click="Prompts_Click" IsEnabled="{x:Bind ViewModel.CanSend, Mode=OneWay}"
                AutomationProperties.Name="Suggested questions" ToolTipService.ToolTip="Suggested questions">
          <TextBlock Text="✦" FontSize="18" />
        </Button>
        <TextBox x:Name="MessageBox" Grid.Column="1" MinHeight="44" MaxHeight="120" AcceptsReturn="True"
                 TextWrapping="Wrap" VerticalContentAlignment="Center" VerticalAlignment="Bottom"
                 PlaceholderText="{x:Bind ViewModel.ComposerPlaceholder, Mode=OneWay}"
                 IsEnabled="{x:Bind ViewModel.CanType, Mode=OneWay}"
                 AutomationProperties.Name="Message"
                 PreviewKeyDown="MessageBox_PreviewKeyDown" PreviewKeyUp="MessageBox_PreviewKeyUp" TextChanged="MessageBox_TextChanged"
                 GotFocus="MessageBox_GotFocus" LostFocus="MessageBox_LostFocus" />
        <Button x:Name="SendButton" Grid.Column="2" Width="44" Height="44" Padding="0" CornerRadius="22"
                VerticalAlignment="Bottom" Style="{StaticResource AccentButtonStyle}" Click="Send_Click"
                AutomationProperties.Name="Send" ToolTipService.ToolTip="Send">
          <SymbolIcon x:Name="SendIcon" Symbol="Send" />
        </Button>
      </Grid>
    </Border>
  </Grid>
</Page>
