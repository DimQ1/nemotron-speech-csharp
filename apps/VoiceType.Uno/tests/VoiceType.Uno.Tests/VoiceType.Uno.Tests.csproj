<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>VoiceType.Uno.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- UI-free core only: the app project targets Uno TFMs (net10.0-desktop /
         net10.0-windows…) that a plain test project cannot reference. -->
    <ProjectReference Include="..\..\src\VoiceType.Uno.Core\VoiceType.Uno.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The job runner and its executors are plain C#. They are compiled into the tests (not referenced: the Uno head cannot be)
         so a real chain of jobs can run through the real JobRunner (JobRunnerChainTests, E2E_SpeakerDiarizationTests). -->
    <Compile Include="..\..\src\VoiceType.Uno\Services\Jobs\JobRunner.cs" Link="Jobs\JobRunner.cs" />
    <Compile Include="..\..\src\VoiceType.Uno\Services\Jobs\IJobExecutor.cs" Link="Jobs\IJobExecutor.cs" />
    <Compile Include="..\..\src\VoiceType.Uno\Services\Jobs\IJobsKeepAlive.cs" Link="Jobs\IJobsKeepAlive.cs" />
    <Compile Include="..\..\src\VoiceType.Uno\Services\Jobs\IRecordingActivity.cs" Link="Jobs\IRecordingActivity.cs" />
    <Compile Include="..\..\src\VoiceType.Uno\Services\Jobs\DeviceConditions.cs" Link="Jobs\DeviceConditions.cs" />
    <Compile Include="..\..\src\VoiceType.Uno\Services\Jobs\GemmaJobExecutors.cs" Link="Jobs\GemmaJobExecutors.cs" />
    <Compile Include="..\..\src\VoiceType.Uno\Services\Jobs\SpeakerJobExecutors.cs" Link="Jobs\SpeakerJobExecutors.cs" />
  </ItemGroup>

</Project>
