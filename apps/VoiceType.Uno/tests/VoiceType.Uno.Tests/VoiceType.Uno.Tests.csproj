<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>VoiceType.Uno.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- UI-free core only: the app project targets Uno TFMs (net10.0-desktop /
         net10.0-windows…) that a plain test project cannot reference. -->
    <ProjectReference Include="..\..\src\VoiceType.Uno.Core\VoiceType.Uno.Core.csproj" />
    <!-- The real Nemotron recognizer (RecognizerFactory) for the end-to-end tests of the History and live pipelines. -->
    <ProjectReference Include="..\..\..\..\libraries\SpeechLib\src\SpeechLib.Providers\SpeechLib.Providers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The job runner and its executors are plain C#. They are compiled into the tests (not referenced: the Uno head cannot be)
         so a real chain of jobs can run through the real JobRunner (JobRunnerChainTests, E2E_SpeakerDiarizationTests). -->
    <Compile Include="..\..\src\VoiceType.Uno\Services\Jobs\JobRunner.cs" Link="Jobs\JobRunner.cs" />
    <Compile Include="..\..\src\VoiceType.Uno\Services\Jobs\IJobExecutor.cs" Link="Jobs\IJobExecutor.cs" />
    <Compile Include="..\..\src\VoiceType.Uno\Services\Jobs\IJobsKeepAlive.cs" Link="Jobs\IJobsKeepAlive.cs" />
    <Compile Include="..\..\src\VoiceType.Uno\Services\Jobs\IRecordingActivity.cs" Link="Jobs\IRecordingActivity.cs" />
    <Compile Include="..\..\src\VoiceType.Uno\Services\Jobs\DeviceConditions.cs" Link="Jobs\DeviceConditions.cs" />
    <Compile Include="..\..\src\VoiceType.Uno\Services\Jobs\GemmaJobExecutors.cs" Link="Jobs\GemmaJobExecutors.cs" />
    <Compile Include="..\..\src\VoiceType.Uno\Services\Jobs\SpeakerJobExecutors.cs" Link="Jobs\SpeakerJobExecutors.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Linux text injection is plain C# (the libX11 P/Invokes only bind when called): the injector's choice
         between typing and pasting runs against fake backends, the X11 typist's pure helpers are tested directly. -->
    <Compile Include="..\..\src\VoiceType.Uno\Services\Platform\IPlatformTextInjector.cs" Link="Platform\IPlatformTextInjector.cs" />
    <Compile Include="..\..\src\VoiceType.Uno\Services\Platform\WindowsTextInjector.cs" Link="Platform\WindowsTextInjector.cs" />
    <Compile Include="..\..\src\VoiceType.Uno\Services\Platform\Linux\LinuxTextInjector.cs" Link="Platform\Linux\LinuxTextInjector.cs" />
    <Compile Include="..\..\src\VoiceType.Uno\Services\Platform\Linux\LinuxKeyboard.cs" Link="Platform\Linux\LinuxKeyboard.cs" />
    <Compile Include="..\..\src\VoiceType.Uno\Services\Platform\Linux\LinuxClipboard.cs" Link="Platform\Linux\LinuxClipboard.cs" />
    <Compile Include="..\..\src\VoiceType.Uno\Services\Platform\Linux\LinuxSession.cs" Link="Platform\Linux\LinuxSession.cs" />
    <Compile Include="..\..\src\VoiceType.Uno\Services\Platform\Linux\X11ActiveWindow.cs" Link="Platform\Linux\X11ActiveWindow.cs" />
  </ItemGroup>

</Project>
