<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>SpeechLib</RootNamespace>
    <AssemblyName>SpeechLib</AssemblyName>
  </PropertyGroup>

  <!-- Plain ONNX Runtime, used by the universal Silero VAD filter
       (Audio/SileroVadFilter.cs). Model-specific providers (Nemotron GenAI,
       Parakeet) keep their own ORT references in their own projects.
       Keep this version in lockstep with SpeechLib.Providers, which pins the
       ORT version required by ONNX Runtime GenAI. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
  </ItemGroup>

  <!--
    SpeechLib is the portable contract layer. Runtime/model/audio providers are
    separate projects so applications pay only for the provider they select.
    The ONNX Runtime GenAI sources (ModelSession, LanguageMapper, the GenAi
    helpers) live in SpeechLib.Providers next to the package they depend on.
  -->
</Project>
