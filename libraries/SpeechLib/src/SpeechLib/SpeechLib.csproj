<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>SpeechLib</RootNamespace>
    <AssemblyName>SpeechLib</AssemblyName>
  </PropertyGroup>

  <!-- Plain ONNX Runtime, used by the universal Silero VAD filter
       (Audio/SileroVadFilter.cs). The model-specific providers (Nemotron,
       Parakeet, Qwen3-ASR, VibeVoice) reference ORT in SpeechLib.Providers.
       Keep this version in lockstep with SpeechLib.Providers. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
  </ItemGroup>

  <!--
    SpeechLib is the portable contract layer. Runtime/model/audio providers are
    separate projects so applications pay only for the provider they select.
    The model-specific recognizers and the LanguageMapper live in
    SpeechLib.Providers next to the ONNX Runtime package they depend on.
  -->
</Project>
