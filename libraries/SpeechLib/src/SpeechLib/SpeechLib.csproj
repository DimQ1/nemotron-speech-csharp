<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>SpeechLib</RootNamespace>
    <AssemblyName>SpeechLib</AssemblyName>
  </PropertyGroup>

  <!--
    SpeechLib is the portable contract layer. Runtime/model/audio providers are
    separate projects so applications pay only for the provider they select.
  -->
  <ItemGroup>
    <Compile Remove="Audio\AudioUtils.cs" />
    <Compile Remove="Audio\BufferedCaptureSource.cs" />
    <Compile Remove="Audio\LoopbackAudioSource.cs" />
    <Compile Remove="Audio\MicAudioSource.cs" />
    <Compile Remove="Audio\MixAudioSource.cs" />
    <Compile Remove="Common.cs" />
    <Compile Remove="LanguageMapper.cs" />
    <Compile Remove="ModelSession.cs" />
    <Compile Remove="Models\SpeechRecognitionOptions.cs" />
    <Compile Remove="Models\SpeechRecognitionOptionsBuilder.cs" />
    <Compile Remove="Transcriber.cs" />
  </ItemGroup>

</Project>
