<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>SpeechLib.Providers</RootNamespace>
    <AssemblyName>SpeechLib.Providers</AssemblyName>
  </PropertyGroup>

  <!--
    Single recognition library: Nemotron (ORT GenAI) and Parakeet TDT (plain
    ONNX Runtime) providers, plus the RecognizerFactory that selects between
    them and applies shared decorators. Applications consume only the
    IStreamingSpeechRecognizer interface returned by the factory.
  -->
  <ItemGroup>
    <ProjectReference Include="..\SpeechLib\SpeechLib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Plain ONNX Runtime powers Parakeet TDT and the shared Silero VAD filter. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" GeneratePathProperty="true" />
    <!--
      WebGPU execution provider, shipped as a plugin EP: a standalone native library
      registered at runtime against the same OrtEnv, so no special ORT build is needed.
      Plugin versions are independent of the core ORT version (WebGPU 0.4.0 pairs with
      ONNX Runtime 1.30.0). Re-pick the plugin version when ORT is bumped.
    -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.EP.WebGpu" Version="0.4.0" GeneratePathProperty="true" />
    <!-- FFT for the host-side Whisper log-mel used by the Qwen3-ASR encoder. -->
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
  </ItemGroup>

  <!--
    CPU-only ONNX Runtime GenAI. The CUDA / DirectML / Blackwell variants that were
    selected through the GpuArch property have been removed: every build
    configuration in this repository (CI workflows, build scripts, both desktop apps
    and their settings UI) already ran CPU-only, no source file consumed the GPU_*
    constants, and an unqualified `dotnet build` silently pulled the CUDA flavour.

    GenAI 0.16.0 depends on ONNX Runtime 1.30.0 (see its nuspec): the GenAI and
    plain ORT PackageReference versions above must be bumped together, otherwise
    the managed ORT assembly and the GenAI native DLL disagree.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntimeGenAI" Version="0.16.0" />
  </ItemGroup>

  <!--
    Copy the ONNX Runtime native assets next to the build output. The source path
    comes from GeneratePathProperty on the PackageReference above, so an ORT
    version bump only has to touch the version, never this path.
  -->
  <Target Name="CopyOrtNativeAssets" AfterTargets="Build"
          Condition="Exists('$(PkgMicrosoft_ML_OnnxRuntime)\runtimes\win-x64\native\onnxruntime.dll')">
    <ItemGroup>
      <_OrtNative Include="$(PkgMicrosoft_ML_OnnxRuntime)\runtimes\win-x64\native\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_OrtNative)"
          DestinationFolder="$(OutputPath)runtimes\win-x64\native"
          SkipUnchangedFiles="false" />
  </Target>

  <!--
    Copy the WebGPU plugin EP next to the ORT native assets so it can be registered
    at runtime by name. dxcompiler.dll / dxil.dll come along: Dawn compiles WGSL
    through DXC, and the plugin fails to create a device without them.
    Uses the GeneratePathProperty-based package path for the same reason as
    CopyOrtNativeAssets above.
  -->
  <Target Name="CopyWebGpuPluginNativeAssets" AfterTargets="Build"
          Condition="Exists('$(PkgMicrosoft_ML_OnnxRuntime_EP_WebGpu)\runtimes\win-x64\native\onnxruntime_providers_webgpu.dll')">
    <ItemGroup>
      <_WebGpuNative Include="$(PkgMicrosoft_ML_OnnxRuntime_EP_WebGpu)\runtimes\win-x64\native\onnxruntime_providers_webgpu*.dll" />
      <_WebGpuNative Include="$(PkgMicrosoft_ML_OnnxRuntime_EP_WebGpu)\runtimes\win-x64\native\dxcompiler.dll" />
      <_WebGpuNative Include="$(PkgMicrosoft_ML_OnnxRuntime_EP_WebGpu)\runtimes\win-x64\native\dxil.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_WebGpuNative)"
          DestinationFolder="$(OutputPath)runtimes\win-x64\native"
          SkipUnchangedFiles="false" />
  </Target>

</Project>
