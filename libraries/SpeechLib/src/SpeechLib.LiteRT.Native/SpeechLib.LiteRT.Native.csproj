<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SpeechLib.LiteRT.Native</RootNamespace>
    <AssemblyName>SpeechLib.LiteRT.Native</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SpeechLib\SpeechLib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The scheduler is tested against a fake engine (IGemmaEngine) without the model. -->
    <InternalsVisibleTo Include="SpeechLib.LiteRT.Native.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      LiteRtLmSharp 1.4.0-dimq1.1 = native LiteRT-LM v0.18.0 (Google's official C API prebuilts), validated
      on Windows x64 CPU/GPU. It is the fork's build of the engine-usage improvements this app relies on
      (see docs/research/litert/engine-improvements.md): a non-blocking conversation.TokenCountCached,
      Snapshot()/Resume() for continuing after a cancellation, an opt-in LiteRtEngine.AllowMultipleEngines,
      and a readable LiteRtSamplerNotSupportedException for the Greedy/TopK samplers the CPU backend does
      not implement. They were contributed upstream as OrihuelaConde/LiteRtLmSharp#15; the maintainer has
      reworked them towards his own 1.4.0 (per-engine AllowMultipleEngines, Greedy/TopK sent as TopP, a
      Clone() checkpoint instead of Snapshot()/Resume(), keyed chat clients), so the two builds are
      different assemblies. Hence the prerelease-suffixed version: pin 1.4.0-dimq1.1 for this build and
      1.4.0 for nuget.org's, and a restore can never take one for the other (a package id + version
      identifies a build in the NuGet cache, not the feed it came from). The superseded fork 1.4.0 stays
      published for history and is no longer referenced.

      The packages come from this fork's GitHub Packages feed (DimQ1/LiteRtLmSharp, published by
      .github/workflows/publish-github-packages.yml); this repository restores them from the local
      folder feed (nuget-feed/litertlmsharp, filled by tools/scripts/fetch-litertlmsharp-feed.ps1 from
      the fork's v1.4.0-dimq1.1 release assets), because GitHub Packages requires an authenticated read
      even for public packages. The root nuget.config maps LiteRtLmSharp* to that feed; see the project
      README.

      Runtime packages are RID-selected at publish time: win-x64 for Windows builds, linux-x64 (validated
      on real hardware, CPU + WebGPU->Vulkan GPU) for Linux builds, android-arm64 (OpenCL/WebGPU
      accelerators) for Android.
    -->
    <PackageReference Include="LiteRtLmSharp" Version="1.4.0-dimq1.1" />
    <PackageReference Include="LiteRtLmSharp.runtime.win-x64" Version="1.4.0-dimq1.1" />
    <PackageReference Include="LiteRtLmSharp.runtime.linux-x64" Version="1.4.0-dimq1.1" />
    <PackageReference Include="LiteRtLmSharp.runtime.android-arm64" Version="1.4.0-dimq1.1" />
  </ItemGroup>

</Project>
