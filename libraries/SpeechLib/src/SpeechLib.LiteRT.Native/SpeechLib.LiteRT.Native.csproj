<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\..\..\nuget-feed\litertlmsharp\Version.props" />

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SpeechLib.LiteRT.Native</RootNamespace>
    <AssemblyName>SpeechLib.LiteRT.Native</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SpeechLib\SpeechLib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The scheduler is tested against a fake engine (IGemmaEngine) without the model. -->
    <InternalsVisibleTo Include="SpeechLib.LiteRT.Native.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The DimQ1/LiteRtLmSharp fork ships LiteRT-LM 0.19.1 / C API 1.0.0 and the reviewed engine fixes.
      Managed and runtime packages share the version in nuget-feed/litertlmsharp/Version.props;
      the fetch script and Uno's macOS runtime reference read the same property.
      The root nuget.config restores the public release mirror as a token-free folder feed.
      GitHub Packages is available with read:packages credentials (see the feed README).
      Native binaries from 0.18 or earlier are ABI-incompatible; update the whole set together.
      Partial streamed continuation uses application-owned text history, not the removed Snapshot API.
    -->
    <PackageReference Include="LiteRtLmSharp" Version="[$(LiteRtLmSharpVersion)]" />
    <PackageReference Include="LiteRtLmSharp.runtime.win-x64" Version="[$(LiteRtLmSharpVersion)]" />
    <PackageReference Include="LiteRtLmSharp.runtime.linux-x64" Version="[$(LiteRtLmSharpVersion)]" />
    <PackageReference Include="LiteRtLmSharp.runtime.android-arm64" Version="[$(LiteRtLmSharpVersion)]" />
  </ItemGroup>

</Project>
