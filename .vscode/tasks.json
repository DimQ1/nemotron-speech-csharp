{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/apps/VoiceType.Uno/src/VoiceType.Uno/VoiceType.Uno.csproj",
                "-c", "Debug",
                "-f", "net10.0-windows10.0.26100",
                "-p:GpuArch=CPU"
            ],
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "run: VoiceType.Uno (Linux WSL2)",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/tools/scripts/run-voicetype-uno-linux.ps1"
            ],
            "problemMatcher": []
        },
        {
            "label": "aspire-dashboard",
            "command": "docker",
            "type": "process",
            "args": [
                "run", "--rm", "-it",
                "-p", "18888:18888",
                "-p", "4317:18889",
                "mcr.microsoft.com/dotnet/aspire-dashboard:latest"
            ],
            "problemMatcher": [],
            "isBackground": true
        }
    ]
}