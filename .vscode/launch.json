{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug VoiceType.Uno (Windows)",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/apps/VoiceType.Uno/src/VoiceType.Uno/bin/Debug/net10.0-windows10.0.26100/VoiceType.Uno.exe",
            "cwd": "${workspaceFolder}/apps/VoiceType.Uno/src/VoiceType.Uno",
            "preLaunchTask": "build",
            "stopAtEntry": false,
            "justMyCode": true,
            "console": "internalConsole"
        },
        {
            "name": "Run VoiceType.Uno (Windows, no debugger)",
            "type": "node-terminal",
            "request": "launch",
            "command": "dotnet run --project apps/VoiceType.Uno/src/VoiceType.Uno/VoiceType.Uno.csproj -f net10.0-windows10.0.26100 -c Debug -p:GpuArch=CPU",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Run VoiceType.Uno (Linux WSL2)",
            "type": "node-terminal",
            "request": "launch",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}/tools/scripts/run-voicetype-uno-linux.ps1\"",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Attach VoiceType.Uno",
            "type": "coreclr",
            "request": "attach",
            "processName": "VoiceType.Uno.exe",
            "requireExactSource": false
        }
    ]
}