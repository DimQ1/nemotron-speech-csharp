+    /// generation on different engines runs truly in parallel (CPU cores are shared), whereas conversations
+    /// of one engine are serialized by the native runtime. Set before the first <see cref="Load"/>.
+    /// </summary>
+    public static bool AllowMultipleEngines
+    {
+        get => EngineLiveness.AllowMultiple;
+        set => EngineLiveness.AllowMultiple = value;
+    }
